f; checkout runs git init before\n# any workflow step can configure Git.\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: init.defaultBranch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  link-checker:\n    name: Check Links\n    runs-on: ubuntu-24.04\n    # Typical run: <1min with lychee cache. 10min prevents slow\n    # external hosts or Wayback Machine probes from hanging the workflow.\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-link-checker\n      cancel-in-progress: true\n    permissions:\n      contents: read\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      # lychee keeps results for --max-cache-age 1d. Scoping the cache to the\n      # UTC day restores only a cache saved today, so lychee never has to\n      # discard a restored cache as \"too old\".\n      - name: Name today's link cache\n        id: link-cache\n        run: echo \"day=$(date -u +%F)\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Restore link cache\n        id: restore-link-cache\n        uses: actions/cache/restore@v5\n        with:\n          path: .lycheecache\n          key: cache-lychee-${{ runner.os }}-${{ steps.link-cache.outputs.day }}-${{ github.sha }}\n          restore-keys: cache-lychee-${{ runner.os }}-${{ steps.link-cache.outputs.day }}-\n\n      - name: Install pinned lychee with download retries\n        run: bash scripts/install-lychee.sh\n        env:\n          LYCHEE_VERSION: v0.24.2\n          LYCHEE_SHA256_X86_64: 1f4e0ef7f6554a6ed33dd7ac144fb2e1bbed98598e7af973042fc5cd43951c9a\n          LYCHEE_SHA256_AARCH64: 91a7bd65685da41b90ccb9bc867a3d649a7818042dae04ff405e55a25bddee4c\n\n      - name: Check links with lychee\n        id: lychee\n        env:\n          GITHUB_TOKEN: [REDACTED] secrets.GITHUB_TOKEN }}\n        run: |\n          mkdir -p lychee\n          # Discard a stale report so a CLI error cannot reuse its evidence.\n          rm -f lychee/out.md\n          code=0\n          # Keep research data, Vite-only asset URLs and parser fixtures out\n          # of the raw file scan, as in the previous action configuration.\n          lychee --mode task --format markdown --output lychee/out.md \\\n            --verbose --no-progress --cache --max-cache-age 1d \\\n            --max-retries 3 --timeout 30 --hidden --extensions md,html \\\n            --exclude-path docs/case-studies --exclude-path dev/log \\\n            --exclude-path examples/universal-app/index.html \\\n            --exclude-path tests/fixtures . || code=$?\n          echo \"exit_code=$code\" >> \"$GITHUB_OUTPUT\"\n          if [ ! -s lychee/out.md ]; then\n            echo \"::error title=lychee failed::lychee exited with code $code without writing a report.\"\n            exit 1\n          fi\n          cat lychee/out.md\n          cat lychee/out.md >> \"$GITHUB_STEP_SUMMARY\"\n          if [ \"$code\" -ne 0 ] && [ \"$code\" -ne 2 ]; then\n            echo \"::error title=lychee failed::lychee exited with code $code.\"\n            exit 1\n          fi\n          if ! grep -Eq 'Total[[:space:]]*\\|[[:space:]]*[1-9][0-9]*[[:space:]]*\\|' lychee/out.md; then\n            echo \"::error title=No links checked::Report has no positive Total count. Check the lychee arguments.\"\n            exit 1\n          fi\n          # Exit 2 with a report is left to the existing re-check/archive\n          # diagnostics and final failure step, just as with fail: false.\n\n      - name: Save main link cache\n        if: github.event_name == 'push' && github.ref == 'refs/heads/main' && steps.restore-link-cache.outputs.cache-hit != 'true'\n        uses: actions/cache/save@v5\n        with:\n          path: .lycheecache\n          key: ${{ steps.restore-link-cache.outputs.cache-primary-key }}\n\n      - name: Re-check transient link failures\n        # Retry transport errors, 429, and 5xx within a shared budget.\n        # GitHub blob/tree pages also use the authenticated contents API.\n        if: steps.lychee.outputs.exit_code != 0\n        id: recheck\n        run: node scripts/recheck-broken-links.mjs\n        env:\n          LYCHEE_OUTPUT: lychee/out.md\n          RECOVERED_OUTPUT: lychee/recovered.txt\n          GITHUB_TOKEN: [REDACTED] secrets.GITHUB_TOKEN }}\n\n      - name: Check broken links against Web Archive\n        # `!= 'true'`, never `== 'false'`: a skipped re-check leaves the\n        # output empty, and only the != form fails safe.\n        if: >-\n          steps.lychee.outputs.exit_code != 0 &&\n          steps.recheck.outputs.all_recovered != 'true'\n        id: webarchive\n        run: node scripts/check-web-archive.mjs\n        env:\n          LYCHEE_OUTPUT: lychee/out.md\n          RECOVERED_URLS: lychee/recovered.txt\n          LYCHEE_EXIT_CODE: ${{ steps.lychee.outputs.exit_code }}\n\n      - name: Upload broken-link diagnostics\n        if: \"!cancelled() && steps.lychee.outputs.exit_code != '0'\"\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: lychee-report\n          path: lychee/\n          required-file: lychee/out.md\n          if-no-files-found: error\n\n      - name: Fail if broken links were found\n        if: >-\n          !cancelled() &&\n          steps.lychee.outputs.exit_code != 0 &&\n          steps.recheck.outputs.all_recovered != 'true'\n        run: |\n          echo \"::error::Broken live links were detected.\"\n          echo \"\"\n          echo \"What happened:\"\n          echo \"  lychee found one or more broken links in the *.md and *.html files of this repository.\"\n          echo \"  An archive is a suggested replacement; it does not make the live link valid.\"\n          echo \"\"\n          echo \"How to fix:\"\n          echo \"  1. Review the 'Check links with lychee' step above for a full list of broken links.\"\n          echo \"  2. For links marked with a '::notice::' annotation above, a Web Archive replacement exists.\"\n          echo \"     Replace those broken links with the suggested archive.org URL.\"\n          echo \"  3. For links with no archive version, either:\"\n          echo \"     a. Find an updated URL that points to the same or equivalent content.\"\n          echo \"     b. Remove the link if the content is no longer relevant.\"\n          echo \"     c. Add the URL to .lycheeignore if it is a known false positive.\"\n          echo \"\"\n          echo \"Report location: lychee/out.md (available as a workflow artifact if configured).\"\n          exit 1\n\n  # Terminal status gate: runs even when the jobs above fail or are\n  # cancelled, and turns a `timeout-minutes` kill (reported as cancelled)\n  # into a red run. needs is derived and checked by the status-gate-coverage\n  # job in workflows.yml.\n  pipeline-status:\n    name: Pipeline Status\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-pipeline-status\n      cancel-in-progress: true\n    # A status function is required: without one the gate inherits the\n    # implicit \"every dependency succeeded\" condition and is skipped in\n    # exactly the runs it exists to report.\n    if: >-\n      !cancelled()\n    needs:\n      - link-checker\n    # actions: read lets the gate list this run's jobs and name the ones\n    # GitHub never acquired a runner for.\n    permissions:\n      actions: read\n      contents: read\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n\n      - name: Fail the run when a required job was cancelled or failed\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          GH_TOKEN: [REDACTED] github.token }}\n          RUN_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n          HEAD_REF: ${{ github.event_name == 'pull_request' && format('refs/pull/{0}/head', github.event.number) || github.ref }}\n        run: bash scripts/check-pipeline-status.sh\nname: Heavy checks\n\n# Tests too slow for every pull request (tests/heavy/README.md). Started by\n# hand only: Actions tab -> Heavy checks -> Run workflow, or\n#   gh workflow run heavy.yml -f suite=quality -f limit=5\non:\n  workflow_dispatch:\n    inputs:\n      suite:\n        description: Suite of tests/heavy to run\n        type: choice\n        options:\n          - all\n          - quality\n          - recognition\n          - roundtrip\n          - copy\n          - performance\n          - gpu\n          - lexicon\n        default: all\n      ref:\n        description: Branch or tag of this repository, or a commit on the default branch or on the branch chosen above, to test (empty = the branch chosen above)\n        type: string\n        default: ''\n      limit:\n        description: Largest number of items each test may process (empty = no limit)\n        type: string\n        default: ''\n\n# Least-privilege default; jobs escalate individually when needed.\npermissions:\n  contents: read\n\n# Provide Git config to actions/checkout itself; checkout runs git init before\n# any workflow step can configure Git.\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: init.defaultBranch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  heavy:\n    name: Heavy checks\n    runs-on: ubuntu-24.04\n    # The step budget below (18000s = 300 min) owns the deadline; this cap is\n    # the backstop behind it, below the 360-minute limit of hosted runners,\n    # leaving 30 minutes for checkout, install and the artifact upload. See\n    # docs/CI-TIMEOUT-BUDGETS.md.\n    timeout-minutes: 330\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-${{ inputs.suite }}\n      cancel-in-progress: true\n    permissions:\n      contents: read\n    steps:\n      # The branch chosen in the form: always a branch of this repository.\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      # A run started on the default branch writes to its cache scope, so the\n      # ref input may only name code of this repository; see the script.\n      - name: Resolve the ref to test\n        id: target\n        env:\n          GH_TOKEN: [REDACTED] github.token }}\n          REPOSITORY: ${{ github.repository }}\n          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}\n          FALLBACK_SHA: ${{ github.sha }}\n          WANTED: ${{ inputs.ref }}\n        run: bash scripts/resolve-heavy-ref.sh\n\n      - name: Check out the ref to test\n        if: ${{ steps.target.outputs.revision != github.sha }}\n        uses: actions/checkout@v7\n        with:\n          ref: ${{ steps.target.outputs.revision }}\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n\n      - name: Install dependencies\n        run: npm install\n\n      # Speech datasets fetched by scripts/datasets.mjs (issue 16). The key\n      # changes with the registry, so a changed checksum fetches again.\n      # The cache stays on the runner side: .datasets/ is never uploaded as\n      # an artifact or committed.\n      # performance-rust-waveguide.test.js and performance-rust-fdtd.test.js\n      # compare the JavaScript renderer with src/engine/voice-simulator.wasm\n      # (issues 22 and 23; the second also with the SIMD build, which\n      # build-wasm.mjs leaves in target/simd when it is not shipped). The rustup of the\n      # runner image installs the toolchain of rust-toolchain.toml.\n      # performance-threads.test.js (issue 24) times the native CLI and the\n      # threads file, which needs the nightly toolchain of THREADS_TOOLCHAIN.\n      # performance-tiers.test.js (issue 31) times every tier on JavaScript\n      # and Rust, on one core and (3D tiers) with the threads file, and\n      # compares them with docs/reports/performance-baseline.json; the run\n      # never commits, see \"Heavy checks\" in docs/CONTRIBUTING.md.\n      - name: Build the WebAssembly engine\n        if: inputs.suite == 'performance' || inputs.suite == 'all'\n        run: |\n          bash scripts/run-with-budget-warning.sh 150 \"Rust toolchain install\" rustup toolchain install\n          THREADS_TOOLCHAIN=$(node --input-type=module -e \"import { THREADS_TOOLCHAIN } from './scripts/build-wasm.mjs'; console.log(THREADS_TOOLCHAIN)\")\n          bash scripts/run-with-budget-warning.sh 150 \"nightly toolchain install\" rustup toolchain install \"$THREADS_TOOLCHAIN\" --profile minimal --target wasm32-unknown-unknown --component rust-src\n          bash scripts/run-with-budget-warning.sh 360 \"wasm build\" node scripts/build-wasm.mjs --require --threads\n          bash scripts/run-with-budget-warning.sh 120 \"CLI build\" cargo build --release --locked -p voice-simulator-cli\n\n      - name: Restore the speech dataset cache\n        uses: actions/cache@v6\n        with:\n          path: .datasets\n          key: datasets-${{ hashFiles('datasets/registry.json') }}\n\n      # Suite gpu (tests/heavy/gpu-*.test.js) runs in Deno, whose WebGPU\n      # falls back to Mesa's software OpenGL ES driver on a runner without\n      # a GPU (issue 30). REQUIRE_GPU=1 below turns a missing adapter into a\n      # failure.\n      - name: Install the software OpenGL ES driver\n        if: inputs.suite == 'gpu' || inputs.suite == 'all'\n        run: |\n          sudo apt-get update\n          sudo apt-get install -y --no-install-recommends libegl1 libgles2 libegl-mesa0 libgl1-mesa-dri\n\n      - name: Setup Deno\n        if: inputs.suite == 'gpu' || inputs.suite == 'all'\n        uses: denoland/setup-deno@22d081ff2d3a40755e97629de92e3bcbfa7cf2ed # v2.0.5\n        with:\n          deno-version: v2.x\n\n      - name: Show the WebGPU adapter\n        if: inputs.suite == 'gpu' || inputs.suite == 'all'\n        run: deno run -A scripts/gpu-adapter.mjs\n\n      - name: Run heavy checks\n        shell: bash\n        env:\n          SUITE: ${{ inputs.suite }}\n          LIMIT: ${{ inputs.limit }}\n          REQUIRE_GPU: ${{ (inputs.suite == 'gpu' || inputs.suite == 'all') && '1' || '' }}\n          REQUIRE_WASM: ${{ (inputs.suite == 'performance' || inputs.suite == 'all') && '1' || '' }}\n          REQUIRE_CLI: ${{ (inputs.suite == 'performance' || inputs.suite == 'all') && '1' || '' }}\n          REQUIRE_THREADS_WASM: ${{ (inputs.suite == 'performance' || inputs.suite == 'all') && '1' || '' }}\n        run: |\n          LIMIT_FLAG=''\n          if [[ \"$LIMIT\" =~ ^[0-9]+$ ]]; then\n            LIMIT_FLAG=\"--limit $LIMIT\"\n          fi\n          # LIMIT_FLAG is unquoted on purpose: empty, or a flag and a number.\n          # shellcheck disable=SC2086\n          bash scripts/run-with-budget-warning.sh 18000 \"Heavy checks\" npm run test:heavy -- --suite \"$SUITE\" $LIMIT_FLAG\n\n      - name: Upload reports\n        if: ${{ !cancelled() }}\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: heavy-${{ inputs.suite }}-${{ github.run_id }}\n          path: reports/heavy\n          retention-days: 30\n          if-no-files-found: error\n\n  # Terminal status gate: runs even when the jobs above fail or are\n  # cancelled, and turns a `timeout-minutes` kill (reported as cancelled)\n  # into a red run. needs is derived and checked by the status-gate-coverage\n  # job in workflows.yml.\n  pipeline-status:\n    name: Pipeline Status\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    concurrency:\n      # The suite keeps runs of different suites on one branch from\n      # cancelling each other's gate, as the heavy job's group does.\n      group: check-${{ github.workflow }}-${{ github.ref }}-${{ inputs.suite }}-pipeline-status\n      cancel-in-progress: true\n    # A status function is required: without one the gate inherits the\n    # implicit \"every dependency succeeded\" condition and is skipped in\n","exit_code":0,"status":"completed"}}
