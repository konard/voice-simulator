 analysis frames and says three things without\nknowing the language: where each syllable has its centre (nucleus), where\nthe sound changes abruptly (landmarks: a closure, a release, the start or\nend of voicing), and which broad class every frame belongs to (silence,\nvowel, glide, nasal, voiced fricative, voiceless fricative, closure, burst).\nIn a stream a nucleus is reported at most 150 ms after it was spoken.\n\n## Why\n\n- Live highlighting ({{P62}}) must mark the syllable being spoken long before\n  the words are known. Nuclei give that from energy alone.\n- The decoder ({{P54}}) needs places where a sound may begin or end, and a\n  cheap first guess of the kind of sound, so that it compares each stretch\n  with a few phonemes and not with all 97.\n- Speech rate for the voice fit ({{P51}}) is the number of nuclei per second.\n\n## Current state\n\n- `analyzeVoice` gives one number, `syllableRate`: peaks of a smoothed energy\n  curve of the whole recording. The peak times are not returned and nothing\n  works on a stream.\n- No code finds closures, bursts or the start of voicing, and no code names\n  the kind of sound of a frame.\n- The forward direction knows all of this exactly: `planUtterance` returns\n#!/usr/bin/env node\n\n/**\n * Lint entry point used by `npm run lint`.\n *\n * All files are linted for errors. Warnings are reported only in files that\n * the current branch changes relative to its base, the same files the\n * pre-commit hook lints, or in every file when the branch changes the lint\n * configuration. Every reported error or warning fails the run. Set\n * LINT_ALL_WARNINGS=1 to report every warning, as pushes to main do.\n */\n\nimport { execFileSync } from 'node:child_process';\nimport { ESLint } from 'eslint';\nimport {\n  parseChangedLines,\n  changesLintConfig,\n  filterWarningsToChangedFiles,\n  lintExitCode,\n} from './lint-changed-lines.mjs';\n\nfunction git(args) {\n  return execFileSync('git', args, {\n    encoding: 'utf8',\n    maxBuffer: 64 * 1024 * 1024,\n  });\n}\n\nfunction resolveBaseRef() {\n  const baseRef = process.env.LINT_BASE_REF || process.env.GITHUB_BASE_REF;\n  const candidates = baseRef\n    ? [baseRef, `origin/${baseRef}`]\n    : ['origin/main', 'main', 'origin/master', 'master'];\n\n  for (const candidate of candidates) {\n    try {\n      git(['rev-parse', '--verify', '--quiet', `${candidate}^{commit}`]);\n      return candidate;\n    } catch {\n      continue;\n    }\n  }\n\n  return null;\n}\n\nfunction collectChangedFiles() {\n  const base = resolveBaseRef();\n\n  if (!base) {\n    return null;\n  }\n\n  try {\n    const mergeBase = git(['merge-base', 'HEAD', base]).trim();\n    const committed = git(['diff', '-U0', mergeBase, '--']);\n    const working = git(['diff', '-U0', 'HEAD', '--']);\n    const untracked = git(['ls-files', '--others', '--exclude-standard'])\n      .split('\\n')\n      .filter(Boolean);\n\n    const changed = parseChangedLines(`${committed}\\n${working}`);\n\n    for (const file of untracked) {\n      changed.set(file, true);\n    }\n\n    console.log(\n      `Reporting warnings in ${changed.size} file(s) changed since ${base}.`\n    );\n    return changed;\n  } catch {\n    return null;\n  }\n}\n\nfunction warningScope() {\n  if (process.env.LINT_ALL_WARNINGS === '1') {\n    return null;\n  }\n\n  const changed = collectChangedFiles();\n\n  if (changed && changesLintConfig(changed)) {\n    console.log(\n      'The lint configuration or ESLint packages changed: reporting every warning.'\n    );\n    return null;\n  }\n\n  return changed;\n}\n\nasync function main() {\n  const eslint = new ESLint();\n  const results = await eslint.lintFiles(['.']);\n  const changedFiles = warningScope();\n\n  const reported = changedFiles\n    ? filterWarningsToChangedFiles(results, changedFiles, process.cwd())\n    : results;\n\n  const formatter = await eslint.loadFormatter('stylish');\n  const output = await formatter.format(reported);\n\n  if (output) {\n    console.log(output);\n  }\n\n  const hiddenWarnings =\n    results.reduce((total, result) => total + result.warningCount, 0) -\n    reported.reduce((total, result) => total + result.warningCount, 0);\n\n  if (hiddenWarnings > 0) {\n    console.log(\n      `${hiddenWarnings} warning(s) in unchanged files were not reported. Run LINT_ALL_WARNINGS=1 npm run lint to see them.`\n    );\n  }\n\n  process.exit(lintExitCode(reported));\n}\n\nawait main();\n","exit_code":0,"status":"completed"}}
