[2026-11-17T12:12:14.845Z] [STDOUT] {"type":"item.completed","item":{"id":"item_145","type":"command_execution","command":"/bin/bash -lc \"cat src/recognition/landmark-signals.js && cat src/recognition/landmark-nuclei.js && sed -n '475,555p' crates/voice-simulator-core/src/landmarks.rs && cat tests/helpers/landmark-frames.js\"","aggregated_output":"/** Numerical helpers of the landmark stage (issue 62). No spectra are\n * recomputed: every measurement comes from the shared analysis frames. */\n\nexport const BROAD_CLASSES = Object.freeze([\n  'silence',\n  'vowel',\n  'glide',\n  'nasal',\n  'voiced-fricative',\n  'voiceless-fricative',\n  'closure',\n  'burst',\n]);\n\n/** Mel filter centres, in the same order as frontend.js. */\nexport function sonorityFilters(frames) {\n  const bottom = 2595 * Math.log10(1 + 60 / 700);\n  const top = 2595 * Math.log10(1 + Math.min(frames.rate / 2, 7600) / 700);\n  const selected = [];\n  for (let m = 0; m < frames.melBands; m++) {\n    const centre =\n      700 *\n      (10 **\n        ((bottom + ((top - bottom) * (m + 1)) / (frames.melBands + 1)) / 2595) -\n        1);\n    if (centre >= 300 && centre <= (frames.rate === 8000 ? 2800 : 3000)) {\n      selected.push(m);\n    }\n  }\n  if (!selected.length) {\n    throw new RangeError('mel bank has no filters in the sonority range');\n  }\n  return selected;\n}\n\n/** Compute unsmoothed log energy once per newly added frame. */\nexport function fillSonority(frames, raw, first, filters) {\n  for (let t = first; t < frames.count; t++) {\n    let sum = 0;\n    for (const m of filters) {\n      sum += Math.exp(frames.mel[t * frames.melBands + m]);\n    }\n    raw[t] = 10 * Math.log10(Math.max(sum, 1e-10));\n  }\n}\n\n/** Centred moving mean, 40 ms wide; truncate at recording boundaries. */\nexport function smoothSonority(raw, output, first, count, hop) {\n  const width = Math.max(1, Math.round(0.04 / hop));\n  const left = Math.floor(width / 2);\n  const right = width - left - 1;\n  for (let t = first; t < count; t++) {\n    let sum = 0;\n    const lo = Math.max(0, t - left);\n    const hi = Math.min(count - 1, t + right);\n    for (let j = lo; j <= hi; j++) {\n      sum += raw[j];\n    }\n    output[t] = sum / (hi - lo + 1);\n  }\n}\n\nfunction rise(frames, t, band, d) {\n  return (\n    frames.band[Math.min(frames.count - 1, t + d) * 6 + band] -\n    frames.band[Math.max(0, t - d) * 6 + band]\n  );\n}\n\nfunction nearestFinePeak(frames, t, b, sign, fine, radius) {\n  let nearest = -1;\n  for (\n    let j = Math.max(1, t - radius);\n    j <= Math.min(frames.count - 2, t + radius);\n    j++\n  ) {\n    const v = sign * rise(frames, j, b, fine);\n    if (\n      v > 0 &&\n      v > sign * rise(frames, j - 1, b, fine) &&\n      v >= sign * rise(frames, j + 1, b, fine) &&\n      (nearest < 0 || Math.abs(j - t) < Math.abs(nearest - t))\n    ) {\n      nearest = j;\n    }\n  }\n  return nearest;\n}\n\nfunction bandPeaks(frames, threshold, first, last, { coarse, fine, radius }) {\n  const peaks = [];\n  for (let b = 0; b < 6; b++) {\n    for (\n      let t = Math.max(1, first - radius);\n      t < Math.min(last + radius, frames.count - 1);\n      t++\n    ) {\n      const value = rise(frames, t, b, coarse);\n      const sign = value > 0 ? 1 : -1;\n      const strength = Math.abs(value);\n      if (\n        strength < threshold ||\n        strength <= Math.abs(rise(frames, t - 1, b, coarse)) ||\n        strength < Math.abs(rise(frames, t + 1, b, coarse))\n      ) {\n        continue;\n      }\n      const nearest = nearestFinePeak(frames, t, b, sign, fine, radius);\n      if (nearest >= first && nearest < last) {\n        peaks.push({ t: nearest, b, sign, strength });\n      }\n    }\n  }\n  return peaks;\n}\n\nfunction participatingBands(frames, peaks, { t, sign }, maxBand) {\n  const bands = new Map();\n  for (const other of peaks) {\n    if (\n      other.b >= 1 &&\n      other.b <= maxBand &&\n      other.sign === sign &&\n      Math.abs(other.t - t) <= Math.round(0.01 / frames.hop)\n    ) {\n      bands.set(other.b, Math.max(bands.get(other.b) ?? 0, other.strength));\n    }\n  }\n  return bands;\n}\n\nfunction addGroupCandidate(frames, peaks, peak, candidates) {\n  const { t, b, sign } = peak;\n  if (b === 0) {\n    return;\n  }\n  const voiced = frames.periodicity[t] >= 0.45;\n  const maxBand = voiced ? 4 : 5;\n  if (b > maxBand) {\n    return;\n  }\n  const bands = participatingBands(frames, peaks, peak, maxBand);\n  if (bands.size >= 3) {\n    candidates.push({\n      t,\n      type: `${voiced ? 's' : 'b'}${sign > 0 ? '+' : '-'}`,\n      strength: [...bands.values()].reduce((a, b) => a + b, 0) / bands.size,\n    });\n  }\n}\n\n/** Coarse peaks are relocated onto the nearest fine peak within 20 ms.\n * Endpoints of a plateau choose its first frame, deterministically. */\nexport function landmarkCandidates(\n  frames,\n  threshold,\n  first = 0,\n  last = frames.count,\n  previous = []\n) {\n  const coarse = Math.max(1, Math.round(0.025 / frames.hop));\n  const fine = Math.max(1, Math.round(0.013 / frames.hop));\n  const radius = Math.round(0.02 / frames.hop);\n  // A candidate near the left edge still needs the bands just before it.\n  const peaks = bandPeaks(\n    frames,\n    threshold,\n    Math.max(0, first - Math.round(0.01 / frames.hop)),\n    last,\n    {\n      coarse,\n      fine,\n      radius,\n    }\n  );\n  const candidates = [];\n  for (const peak of peaks) {\n    const { t, b, sign } = peak;\n    if (t < first) {\n      continue;\n    }\n    const before = frames.periodicity[Math.max(0, t - coarse)] >= 0.45;\n    const after =\n      frames.periodicity[Math.min(frames.count - 1, t + coarse)] >= 0.45;\n    if (b === 0 && before !== after && sign > 0 === after) {\n      candidates.push({\n        t,\n        type: sign > 0 ? 'g+' : 'g-',\n        strength: peak.strength,\n      });\n    }\n    addGroupCandidate(frames, peaks, peak, candidates);\n  }\n  candidates.sort(\n    (a, b) =>\n      a.t - b.t || a.type.localeCompare(b.type) || b.strength - a.strength\n  );\n  // Seed suppression with the last confirmed candidate of each type before\n  // this window. Dropping that history can resurrect a suppressed neighbour.\n  const kept = previous.slice();\n  for (const item of candidates) {\n    const prior = kept.findLastIndex((p) => p.type === item.type);\n    if (prior >= 0 && (item.t - kept[prior].t) * frames.hop < 0.02 - 1e-9) {\n      if (item.strength > kept[prior].strength) {\n        kept[prior] = item;\n      }\n    } else {\n      kept.push(item);\n    }\n  }\n  return kept.sort((a, b) => a.t - b.t || a.type.localeCompare(b.type));\n}\n\n/** The exact ordered decision tree of issue 62, before temporal clean-up. */\nexport function classifyFrame(frames, sonority, t, peak, burst, T) {\n  const e = frames.energy[t] - frames.noise[t];\n  if (!frames.speech[t] && e < T.silence) {\n    return 0;\n  }\n  if (frames.periodicity[t] < T.voiced) {\n    return burst ? 7 : 5;\n  }\n  if (\n    frames.zcr[t] > T.fricativeZcr ||\n    frames.gravity[t] > T.fricativeGravity\n  ) {\n    return 4;\n  }\n  if (\n    frames.band[t * 6] - frames.band[t * 6 + 2] > T.nasalDrop &&\n    sonority[t] < peak - T.nasalBelowPeak\n  ) {\n    return 3;\n  }\n  if (sonority[t] < peak - T.glideBelowPeak) {\n    return 2;\n  }\n  return 1;\n}\n\n/** Median of five class numbers, then bounded silence/run clean-up.\n * Returns a separate array so all run decisions see the same neighbours. */\nfunction medianAndClosures(raw, count, hop) {\n  const median = new Uint8Array(count);\n  const window = new Uint8Array(5);\n  for (let t = 0; t < count; t++) {\n    for (let k = -2; k <= 2; k++) {\n      window[k + 2] = raw[Math.max(0, Math.min(count - 1, t + k))];\n    }\n    window.sort();\n    median[t] = window[2];\n  }\n  const closed = median.slice();\n  for (let start = 0; start < count; ) {\n    let end = start + 1;\n    while (end < count && median[end] === median[start]) {\n      end++;\n    }\n    if (\n      median[start] === 0 &&\n      start > 0 &&\n      end < count &&\n      (end - start) * hop < 0.15 - 1e-9\n    ) {\n      closed.fill(6, start, end);\n    }\n    start = end;\n  }\n  return closed;\n}\n\nexport function cleanClasses(raw, count, hop) {\n  const closed = medianAndClosures(raw, count, hop);\n  const output = closed.slice();\n  for (let start = 0; start < count; ) {\n    let end = start + 1;\n    while (end < count && closed[end] === closed[start]) {\n      end++;\n    }\n    const minimum = closed[start] === 7 ? 0.005 : 0.015;\n    if ((end - start) * hop < minimum - 1e-9) {\n      let left = start;\n      while (left > 0 && closed[left - 1] === closed[start - 1]) {\n        left--;\n      }\n      let right = end;\n      while (right < count && closed[right] === closed[end]) {\n        right++;\n      }\n      if (start > 0 || end < count) {\n        output.fill(\n          start > 0 && (end === count || start - left >= right - end)\n            ? closed[start - 1]\n            : closed[end],\n          start,\n          end\n        );\n      }\n    }\n    start = end;\n  }\n  return output;\n}\n/** Causal nucleus confirmation shared by batch and streaming calls.\n * A confirmed peak wins over later peaks within the exclusion interval;\n * higher-peak replacement applies only while the earlier peak is pending. */\nexport function createNucleusScanner(frames, output, T) {\n  let scanned = 0;\n  let pending = -1;\n  let pendingLeft = 0;\n  let lastPeak = -1;\n  let valley = 0;\n  const radius = Math.round(0.04 / frames.hop);\n  const separation = Math.ceil(0.08 / frames.hop);\n  const time = (t) => output.startTime + t * frames.hop;\n  const s = output.sonority;\n\n  function minimum(first, end) {\n    let at = first;\n    for (let t = first + 1; t <= end; t++) {\n      if (s[t] < s[at]) {\n        at = t;\n      }\n    }\n    return at;\n  }\n\n  function setEnd(nucleus, right) {\n    const frame = (value) =>\n      Math.round((value - output.startTime) / frames.hop);\n    nucleus.end = time(right);\n    nucleus.strength =\n      s[frame(nucleus.time)] - Math.min(s[frame(nucleus.start)], s[right]);\n  }\n\n  function emit(right, emitted) {\n    if (pending < 0) {\n      return;\n    }\n    const left = pendingLeft;\n    const nucleus = {\n      time: time(pending),\n      start: time(left),\n      end: right === null ? null : time(right),\n      strength:\n        s[pending] - Math.min(s[left], right === null ? s[pending] : s[right]),\n    };\n    output.nuclei.push(nucleus);\n    emitted.push(nucleus);\n    lastPeak = pending;\n    pending = -1;\n  }\n\n  function eligiblePeak(t) {\n    let isPeak =\n      s[t] >= frames.noise[t] + T.nucleusAboveNoise &&\n      frames.periodicity[t] >= 0.45;\n    for (\n      let j = Math.max(0, t - radius);\n      isPeak && j <= Math.min(frames.count - 1, t + radius);\n      j++\n    ) {\n      if (s[j] > s[t] || (j < t && s[j] === s[t])) {\n        isPeak = false;\n      }\n    }\n    if (isPeak && lastPeak >= 0) {\n      const between = minimum(lastPeak, t);\n      isPeak = s[between] <= Math.min(s[lastPeak], s[t]) - T.nucleusDip;\n    }\n    return isPeak;\n  }\n\n  function updateBoundary(t, last) {\n    const prev = output.nuclei.at(-1);\n    if (\n      prev?.end === null &&\n      (!frames.speech[t] ||\n        (t > 0 && t + 1 < last && s[t] <= s[t - 1] && s[t] < s[t + 1]))\n    ) {\n      setEnd(prev, t);\n    }\n  }\n\n  function consider(t, isPeak, prev, emitted) {\n    if (!isPeak || (lastPeak >= 0 && t - lastPeak < separation)) {\n      return;\n    }\n    {\n      if (pending >= 0) {\n        const between = minimum(pending, t);\n        const separate =\n          t - pending >= separation &&\n          s[between] <= Math.min(s[pending], s[t]) - T.nucleusDip;\n        if (separate) {\n          emit(between, emitted);\n          pending = t;\n          pendingLeft = between;\n        } else if (s[t] > s[pending]) {\n          pending = t;\n        }\n      } else {\n        pending = t;\n        pendingLeft = valley;\n        if (prev) {\n          const between = minimum(lastPeak, t);\n          pendingLeft = between;\n          setEnd(prev, between);\n        }\n      }\n      valley = t;\n    }\n  }\n\n  function scanNuclei(last, emitted, final) {\n    for (; scanned < last; scanned++) {\n      const t = scanned;\n      if (s[t] <= s[valley]) {\n        valley = t;\n      }\n      updateBoundary(t, last);\n      const prev = output.nuclei.at(-1);\n      const isPeak = eligiblePeak(t);\n      consider(t, isPeak, prev, emitted);\n      const available = Math.min(frames.count - 1, t + radius);\n      const right = pending < 0 ? 0 : minimum(pending, available);\n      if (\n        pending >= 0 &&\n        (s[right] <= s[pending] - T.nucleusDip ||\n          (available - pending) * frames.hop >= 0.1)\n      ) {\n        emit(!frames.speech[right] ? right : null, emitted);\n      }\n    }\n    if (final) {\n      emit(null, emitted);\n      const prev = output.nuclei.at(-1);\n      if (prev?.end === null) {\n        for (let t = lastPeak + 1; t < frames.count; t++) {\n          if (!frames.speech[t]) {\n            setEnd(prev, t);\n            break;\n          }\n        }\n      }\n    }\n  }\n\n  return scanNuclei;\n}\n            (26, -10.0),\n            (32, 8.0),\n            (44, -30.0),\n            (66, 15.0),\n            (99, -50.0),\n        ];\n        for edge in points.windows(2) {\n            let (left, low) = edge[0];\n            let (right, high) = edge[1];\n            for (t, value) in s.iter_mut().enumerate().take(right + 1).skip(left) {\n                *value = low + (high - low) * (t - left) as f32 / (right - left) as f32;\n            }\n        }\n        for t in 0..count {\n            rows[t * 14 + 1] = -100.0;\n            rows[t * 14 + 2] = 1.0;\n            rows[t * 14 + 3] = 0.9;\n        }\n        let frames = Frames {\n            rows: &rows,\n            count,\n            mel_bands: 1,\n            rate: 8000.0,\n            hop: 0.005,\n        };\n        let thresholds = Thresholds([7.0, 0.75, 0.225, 800.0, 18.0, 0.6, 1.0, 10.0, 2.0, 9.0]);\n        let result = nuclei(&frames, &s, &thresholds);\n        assert_eq!(result.len(), 2);\n        assert_eq!(result[0].end, Some(44));\n        assert_eq!(result[0].strength, 50.0);\n    }\n    #[test]\n    fn nucleus_does_not_require_speech_flag() {\n        let count = 80;\n        let mut rows = vec![0.0; count * 14];\n        for t in 0..count {\n            rows[t * 14 + 1] = -80.0;\n            rows[t * 14 + 3] = 0.9;\n        }\n        let frames = Frames {\n            rows: &rows,\n            count,\n            mel_bands: 1,\n            rate: 8000.0,\n            hop: 0.005,\n        };\n        let s: Vec<f32> = (0..count).map(|t| 20.0 - t.abs_diff(40) as f32).collect();\n        let thresholds = Thresholds([7.0, 0.75, 0.225, 800.0, 18.0, 0.6, 1.0, 10.0, 2.0, 9.0]);\n        let result = nuclei(&frames, &s, &thresholds);\n        assert_eq!(result.len(), 1);\n        assert_eq!(result[0].frame, 40);\n    }\n    #[test]\n    fn silence_and_bounded_closure() {\n        let mut raw = vec![1; 100];\n        raw[40..60].fill(0);\n        assert!(clean_classes(&raw, 0.005)[40..60].iter().all(|v| *v == 6));\n        raw[40..80].fill(0);\n        assert_eq!(clean_classes(&raw, 0.005)[50], 0);\n        assert!(clean_classes(&[], 0.005).is_empty());\n    }\n}\n/** Two voiced peaks, with a shallow early valley and a deeper inter-peak\n * minimum. Tests supply features directly to isolate the landmark stage. */\nimport { analyzeFrames } from '../../src/recognition/frontend.js';\nimport { createRandom } from '../../src/random.js';\n\n/** Isolated features with a quiet mel floor, suitable for analytic rules. */\nexport function ruleFrames(hop = 0.005, seconds = 0.8) {\n  const frames = analyzeFrames(new Float32Array(16000 * seconds), 16000, {\n    hop,\n  });\n  frames.energy.fill(-20);\n  frames.noise.fill(-80);\n  frames.speech.fill(1);\n  frames.periodicity.fill(0.9);\n  frames.zcr.fill(0);\n  frames.gravity.fill(0);\n  frames.band.fill(-40);\n  frames.mel.fill(-30);\n  return frames;\n}\n\n/** Short seeded band walks expose suppression across streaming windows. */\nexport function candidateFrames(seed = 5) {\n  const count = 160;\n  const random = createRandom(seed);\n  const frames = {\n    rate: 16000,\n    hop: 0.005,\n    count,\n    capacity: count,\n    startTime: 0,\n    melBands: 24,\n    mel: new Float32Array(count * 24).fill(-20),\n    band: new Float32Array(count * 6),\n    energy: new Float32Array(count).fill(-10),\n    noise: new Float32Array(count).fill(-80),\n    speech: new Uint8Array(count).fill(1),\n    periodicity: new Float32Array(count),\n    zcr: new Float32Array(count),\n    gravity: new Float32Array(count),\n    tilt: new Float32Array(count),\n  };\n  for (let t = 0; t < count; t++) {\n    frames.periodicity[t] = Math.floor(t / 13) % 2;\n    for (let b = 0; b < 6; b++) {\n      const prior = t ? frames.band[(t - 1) * 6 + b] : -30;\n      frames.band[t * 6 + b] = prior + (random() - 0.5) * 20;\n    }\n  }\n  return frames;\n}\n\nexport function boundaryFrames(trailingSilence = false) {\n  const frames = analyzeFrames(new Float32Array(4000), 8000);\n  frames.noise.fill(-100);\n  frames.periodicity.fill(0.9);\n  frames.speech.fill(1);\n  const points = [\n    [0, -20],\n    [20, 20],\n    [26, -10],\n    [32, 8],\n    [44, -30],\n    [66, 15],\n    [90, -50],\n    [99, -50],\n  ];\n  for (let t = 0, part = 0; t < frames.count; t++) {\n    while (part + 2 < points.length && t > points[part + 1][0]) {\n      part++;\n    }\n    const [left, low] = points[part];\n    const [right, high] = points[part + 1];\n    const db = low + ((high - low) * (t - left)) / (right - left);\n    frames.mel.fill(\n      (db * Math.LN10) / 10,\n      t * frames.melBands,\n      (t + 1) * frames.melBands\n    );\n    if (trailingSilence && t >= 85) {\n      frames.speech[t] = 0;\n    }\n  }\n  return frames;\n}\n","exit_code":0,"status":"completed"}}
