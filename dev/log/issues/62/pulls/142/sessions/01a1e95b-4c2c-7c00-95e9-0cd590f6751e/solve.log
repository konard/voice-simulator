1);\n  });\n\n  it('finds both signs of voicing, sonorant and burst band transitions', () => {\n    for (const hop of [0.005, 0.01]) {\n      for (const kind of ['g', 's', 'b']) {\n        const frames = ruleFrames(hop);\n        const bands = kind === 'g' ? [0] : [1, 2, 3];\n        for (let t = 0; t < frames.count; t++) {\n          const time = t * hop;\n          const db =\n            15 *\n            (Math.tanh((time - 0.2) / 0.007) - Math.tanh((time - 0.5) / 0.007));\n          for (const band of bands) {\n            frames.band[t * 6 + band] = -40 + db;\n          }\n          frames.periodicity[t] =\n            kind === 'g'\n              ? time >= 0.2 && time < 0.5\n                ? 0.9\n                : 0\n              : kind === 's'\n                ? 0.9\n                : 0;\n        }\n        const result = findLandmarks(frames);\n        expect(result.landmarks.length).toBe(2);\n        for (const [i, time] of [0.2, 0.5].entries()) {\n          const landmark = result.landmarks[i];\n          expect(landmark.type).toBe(`${kind}${i === 0 ? '+' : '-'}`);\n          expect(Math.abs(landmark.time - time) <= hop).toBe(true);\n          expect(landmark.strength > 29 && landmark.strength <= 30).toBe(true);\n        }\n        // Below-threshold rises and groups of fewer than three bands\n        // must not produce events of these types.\n        expect(\n          findLandmarks(frames, {\n            thresholds: { landmarkRise: 31 },\n          }).landmarks.length\n        ).toBe(0);\n        if (kind !== 'g') {\n          for (let t = 0; t < frames.count; t++) {\n            frames.band[t * 6 + 3] = -40;\n          }\n        } else {\n          frames.periodicity.fill(0.9);\n        }\n        expect(findLandmarks(frames).landmarks.length).toBe(0);\n      }\n    }\n  });\n\n  it('finds separated voiced energy peaks and rejects unvoiced or noisy peaks', () => {\n    for (const hop of [0.005, 0.01]) {\n      const frames = ruleFrames(hop);\n      for (let t = 0; t < frames.count; t++) {\n        const distance = Math.min(\n          Math.abs(t * hop - 0.2),\n          Math.abs(t * hop - 0.5)\n        );\n        const db = Math.max(-100, 20 - distance * 1000);\n        frames.mel.fill(\n          (db * Math.LN10) / 10,\n          t * frames.melBands,\n          (t + 1) * frames.melBands\n        );\n      }\n      const batch = findLandmarks(frames);\n      expect(batch.nuclei.length).toBe(2);\n      for (const [i, time] of [0.2, 0.5].entries()) {\n        expect(Math.abs(batch.nuclei[i].time - time) <= hop).toBe(true);\n      }\n      const count = frames.count;\n      frames.count = 0;\n      const detector = createLandmarkDetector(frames);\n      const returned = [];\n      while (frames.count < count) {\n        frames.count = Math.min(count, frames.count + Math.round(0.02 / hop));\n        for (const nucleus of detector.advance()) {\n          expect(frames.count * hop - nucleus.time <= 0.15).toBe(true);\n          returned.push(nucleus);\n        }\n      }\n      returned.push(...detector.advance(true));\n      expect(returned.map((n) => n.time)).toEqual(\n        batch.nuclei.map((n) => n.time)\n      );\n      frames.periodicity.fill(0.44);\n      expect(findLandmarks(frames).nuclei.length).toBe(0);\n      frames.periodicity.fill(0.9);\n      frames.noise.fill(40);\n      expect(findLandmarks(frames).nuclei.length).toBe(0);\n    }\n  });\n\n  it('uses a median, bounded closures and the longer neighbouring run', () => {\n    const raw = new Uint8Array(120).fill(1);\n    raw[10] = 5;\n    raw.fill(0, 30, 50);\n    raw.fill(0, 70, 100);\n    const classes = cleanClasses(raw, raw.length, 0.005);\n    expect(classes[10]).toBe(1);\n    expect(Array.from(classes.subarray(30, 50))).toEqual(Array(20).fill(6));\n    expect(Array.from(classes.subarray(70, 100))).toEqual(Array(30).fill(0));\n    const short = new Uint8Array(50).fill(1);\n    short.fill(3, 40, 43);\n    short.fill(2, 43);\n    expect(cleanClasses(short, short.length, 0.002)[41]).toBe(1);\n  });\n});\n{\n  \"description\": \"Experimental fixed-rule detector regression limits, revised following PR 142 comment 6947242499; original goals remain reported.\",\n  \"authority\": \"https://github.com/konard/voice-simulator/pull/142#issuecomment-6947242499\",\n  \"nuclei\": {\n    \"minimumRecall\": 0.6,\n    \"maximumExtrasPerTruth\": 0.35,\n    \"targetRecall\": 0.9,\n    \"targetExtrasPerTruth\": 0.1\n  },\n  \"classes\": {\n    \"16000\": { \"minimumAccuracy\": 0.46, \"targetAccuracy\": 0.85 },\n    \"8000\": { \"minimumAccuracy\": 0.45, \"targetAccuracy\": 0.8 }\n  },\n  \"landmarks\": {\n    \"toleranceSeconds\": 0.02,\n    \"minimumFound\": { \"apa\": 2, \"asa\": 2, \"ama\": 0, \"aba\": 2 },\n    \"targetFound\": 10\n  }\n}\ndiff --git a/.changeset/issue-62-landmarks.md b/.changeset/issue-62-landmarks.md\nindex 04f9ea2..419dd44 100644\n--- a/.changeset/issue-62-landmarks.md\n+++ b/.changeset/issue-62-landmarks.md\n@@ -2,4 +2,4 @@\n 'voice-simulator': minor\n ---\n \n-Add an experimental frame-based detector for syllable nuclei, acoustic landmarks and eight broad sound classes, with batch and streaming APIs, public types, a JSON CLI command, deterministic threshold calibration, a golden-set report and Rust numerical parity. Issue 62 remains blocked: the specified local maxima cannot meet its nucleus recall target on the prescribed synthetic material, and retrospective closure labelling conflicts with the 60 ms commitment deadline.\n+Add an experimental frame-based detector for syllable nuclei, acoustic landmarks and eight broad sound classes, with batch and streaming APIs, public types, a JSON CLI command, deterministic threshold calibration, a golden-set report and Rust numerical parity. Document immutable streaming commitments, confirmed-peak priority, measured quality limits and the owner-revised regression gates; these acoustic guesses do not yet meet the original recognition accuracy goals.\ndiff --git a/c