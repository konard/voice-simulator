frontend.js').FrameSet} frames\n * @param {import('./landmarks.js').LandmarkOptions} [options]\n */\nexport function createLandmarkDetector(frames, options = {}) {\n  if (\n    !(frames.hop > 0) ||\n    !Number.isInteger(frames.capacity) ||\n    frames.capacity < 0\n  ) {\n    throw new RangeError('invalid frame set');\n  }\n  const T = thresholds(options);\n  const filters = sonorityFilters(frames);\n  const raw = new Float32Array(frames.capacity);\n  const rawClasses = new Uint8Array(frames.capacity);\n  const output = {\n    hop: frames.hop,\n    startTime: frames.startTime,\n    count: 0,\n    committed: 0,\n    classes: new Uint8Array(frames.capacity),\n    sonority: new Float32Array(frames.capacity),\n    landmarks: [],\n    nuclei: [],\n  };\n  let seen = 0;\n  let finalized = false;\n  const radius = Math.round(0.04 / frames.hop);\n  const smoothing = Math.ceil(0.02 / frames.hop);\n  const landmarkDelay = Math.ceil(0.07 / frames.hop);\n  const time = (t) => output.startTime + t * frames.hop;\n  const s = output.sonority;\n  const scanNuclei = createNucleusScanner(frames, output, T);\n\n  function classifyPending(candidates) {\n    for (let t = output.committed; t < seen; t++) {\n      let peak = -Infinity;\n      for (\n        let j = Math.max(0, t - Math.round(0.2 / frames.hop));\n        j <= Math.min(seen - 1, t + radius);\n        j++\n      ) {\n        peak = Math.max(peak, s[j]);\n      }\n      const earlier = Math.max(0, t - Math.round(0.02 / frames.hop));\n      const burst =\n        (rawClasses[earlier] === 0 || rawClasses[earlier] === 6) &&\n        candidates.some(\n          (item) =>\n            item.type === 'b+' &&\n            item.t <= t &&\n            (t - item.t) * frames.hop <= 0.02 + 1e-9\n        );\n      rawClasses[t] = classifyFrame(frames, s, t, peak, burst, T);\n    }\n  }\n\n  return {\n    frames,\n    output,\n    advance(final = false) {\n      if (frames.startTime !== output.startTime || frames.count < seen) {\n        throw new Error('landmark stage invalid after trim/reset');\n      }\n      if (finalized) {\n        if (frames.count !== seen) {\n          throw new Error('advance after final');\n        }\n        return [];\n      }\n      if (frames.count > frames.capacity) {\n        throw new RangeError('frame count exceeds capacity');\n      }\n      fillSonority(frames, raw, seen, filters);\n      smoothSonority(\n        raw,\n        s,\n        Math.max(0, seen - smoothing),\n        frames.count,\n        frames.hop\n      );\n      seen = frames.count;\n      output.count = seen;\n      const emitted = [];\n      const stable = final ? seen : Math.max(0, seen - smoothing - radius);\n      scanNuclei(stable, emitted, final);\n      const priorTime = output.landmarks.at(-1)?.time ?? -Infinity;\n      const first = Math.max(\n        0,\n        Math.floor((priorTime - output.startTime) / frames.hop) -\n          Math.round(0.02 / frames.hop)\n      );\n      const candidates = landmarkCandidates(\n        frames,\n        T.landmarkRise,\n        first,\n        seen,\n        previousLandmarks(output, first)\n      );\n      const last = final ? seen : Math.max(0, seen - landmarkDelay);\n      for (const item of candidates) {\n        if (item.t < last && time(item.t) > priorTime + 1e-9) {\n          output.landmarks.push({\n            time: time(item.t),\n            type: item.type,\n            strength: item.strength,\n          });\n        }\n      }\n      classifyPending(candidates);\n      const cleaned = cleanClasses(rawClasses, seen, frames.hop);\n      output.classes.set(cleaned.subarray(output.committed), output.committed);\n      output.committed = final\n        ? seen\n        : Math.max(0, seen - Math.ceil(0.06 / frames.hop));\n      finalized = final;\n      return emitted;\n    },\n  };\n}\n\n/** Whole-recording version of the same stage. */\nexport function findLandmarks(frames, options = {}) {\n  const detector = createLandmarkDetector(frames, options);\n  detector.advance(true);\n  return detector.output;\n}\n/** Causal nucleus confirmation shared by batch and streaming calls. */\nexport function createNucleusScanner(frames, output, T) {\n  let scanned = 0;\n  let pending = -1;\n  let pendingLeft = 0;\n  let lastPeak = -1;\n  let valley = 0;\n  const radius = Math.round(0.04 / frames.hop);\n  const separation = Math.ceil(0.08 / frames.hop);\n  const time = (t) => output.startTime + t * frames.hop;\n  const s = output.sonority;\n\n  function minimum(first, end) {\n    let at = first;\n    for (let t = first + 1; t <= end; t++) {\n      if (s[t] < s[at]) {\n        at = t;\n      }\n    }\n    return at;\n  }\n\n  function setEnd(nucleus, right) {\n    const frame = (value) =>\n      Math.round((value - output.startTime) / frames.hop);\n    nucleus.end = time(right);\n    nucleus.strength =\n      s[frame(nucleus.time)] - Math.min(s[frame(nucleus.start)], s[right]);\n  }\n\n  function emit(right, emitted) {\n    if (pending < 0) {\n      return;\n    }\n    const left = pendingLeft;\n    const nucleus = {\n      time: time(pending),\n      start: time(left),\n      end: right === null ? null : time(right),\n      strength:\n        s[pending] - Math.min(s[left], right === null ? s[pending] : s[right]),\n    };\n    output.nuclei.push(nucleus);\n    emitted.push(nucleus);\n    lastPeak = pending;\n    pending = -1;\n  }\n\n  function eligiblePeak(t) {\n    let isPeak =\n      s[t] >= frames.noise[t] + T.nucleusAboveNoise &&\n      frames.periodicity[t] >= 0.45;\n    for (\n      let j = Math.max(0, t - radius);\n      isPeak && j <= Math.min(frames.count - 1, t + radius);\n      j++\n    ) {\n      if (s[j] > s[t] || (j < t && s[j] === s[t])) {\n        isPeak = false;\n      }\n    }\n    if (isPeak && lastPeak >= 0) {\n      const between = minimum(lastPeak, t);\n      isPeak = s[between] <= Math.min(s[lastPeak], s[t]) - T.nucleusDip;\n    }\n    return isPeak;\n  }\n\n  function updateBoundary(t, last) {\n    const prev = output.nuclei.at(-1);\n    if (\n      prev?.end === null &&\n      (!frames.speech[t] ||\n        (t > 0 && t + 1 < last && s[t] <= s[t - 1] && s[t] < s[t + 1]))\n    ) {\n      setEnd(prev, t);\n    }\n  }\n\n  function consider(t, isPeak, prev, emitted) {\n    if (!isPeak || (lastPeak >= 0 && t - lastPeak < separation)) {\n      return;\n    }\n    {\n      if (pending >= 0) {\n        const between = minimum(pending, t);\n        const separate =\n          t - pending >= separation &&\n          s[between] <= Math.min(s[pending], s[t]) - T.nucleusDip;\n        if (separate) {\n          emit(between, emitted);\n          pending = t;\n          pendingLeft = between;\n        } else if (s[t] > s[pending]) {\n          pending = t;\n        }\n      } else {\n        pending = t;\n        pendingLeft = valley;\n        if (prev) {\n          const between = minimum(lastPeak, t);\n          pendingLeft = between;\n          setEnd(prev, between);\n        }\n      }\n      valley = t;\n    }\n  }\n\n  function scanNuclei(last, emitted, final) {\n    for (; scanned < last; scanned++) {\n      const t = scanned;\n      if (s[t] <= s[valley]) {\n        valley = t;\n      }\n      updateBoundary(t, last);\n      const prev = output.nuclei.at(-1);\n      const isPeak = eligiblePeak(t);\n      consider(t, isPeak, prev, emitted);\n      const available = Math.min(frames.count - 1, t + radius);\n      const right = pending < 0 ? 0 : minimum(pending, available);\n      if (\n        pending >= 0 &&\n        (s[right] <= s[pending] - T.nucleusDip ||\n          (available - pending) * frames.hop >= 0.1)\n      ) {\n        emit(!frames.speech[right] ? right : null, emitted);\n      }\n    }\n    if (final) {\n      emit(null, emitted);\n      const prev = output.nuclei.at(-1);\n      if (prev?.end === null) {\n        for (let t = lastPeak + 1; t < frames.count; t++) {\n          if (!frames.speech[t]) {\n            setEnd(prev, t);\n            break;\n          }\n        }\n      }\n    }\n  }\n\n  return scanNuclei;\n}\n/** Generated by node scripts/calibrate-landmarks.mjs.\n * Class order: silence, vowel, glide, nasal, voiced-fricative, voiceless-fricative, closure, burst.\n * Recall (%): 71.727, 21.695, 10.742, 89.790, 0.000, 86.117, 2.057, 0.058.\n * 8000 Hz recall (%): 71.210, 21.777, 11.709, 89.709, 0.000, 85.922, 1.978, 0.000.\n * 11025 Hz recall (%): 71.533, 21.840, 11.181, 91.525, 0.000, 85.178, 2.057, 0.174.\n * 16000 Hz recall (%): 72.439, 21.467, 9.335, 88.136, 0.000, 87.249, 2.136, 0.000.\n * 371070 labelled frames; three rounds, 21 values per coordinate.\n */\nexport const LANDMARK_THRESHOLDS = Object.freeze({\n  silence: 7,\n  voiced: 0.75,\n  fricativeZcr: 0.225,\n  fricativeGravity: 800,\n  nasalDrop: 18,\n  nasalBelowPeak: 0.6,\n  glideBelowPeak: 1,\n  nucleusAboveNoise: 10,\n  nucleusDip: 2,\n  landmarkRise: 9,\n});\n","exit_code":0,"status":"completed"}}
