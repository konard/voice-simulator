[2026-11-17T11:55:39.939Z] [STDOUT] {"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc 'cat src/recognition/landmark-signals.js scripts/calibrate-landmarks.mjs'","aggregated_output":"/** Numerical helpers of the landmark stage (issue 62). No spectra are\n * recomputed: every measurement comes from the shared analysis frames. */\n\nexport const BROAD_CLASSES = Object.freeze([\n  'silence',\n  'vowel',\n  'glide',\n  'nasal',\n  'voiced-fricative',\n  'voiceless-fricative',\n  'closure',\n  'burst',\n]);\n\n/** Mel filter centres, in the same order as frontend.js. */\nexport function sonorityFilters(frames) {\n  const bottom = 2595 * Math.log10(1 + 60 / 700);\n  const top = 2595 * Math.log10(1 + Math.min(frames.rate / 2, 7600) / 700);\n  const selected = [];\n  for (let m = 0; m < frames.melBands; m++) {\n    const centre =\n      700 *\n      (10 **\n        ((bottom + ((top - bottom) * (m + 1)) / (frames.melBands + 1)) / 2595) -\n        1);\n    if (centre >= 300 && centre <= (frames.rate === 8000 ? 2800 : 3000)) {\n      selected.push(m);\n    }\n  }\n  if (!selected.length) {\n    throw new RangeError('mel bank has no filters in the sonority range');\n  }\n  return selected;\n}\n\n/** Compute unsmoothed log energy once per newly added frame. */\nexport function fillSonority(frames, raw, first, filters) {\n  for (let t = first; t < frames.count; t++) {\n    let sum = 0;\n    for (const m of filters) {\n      sum += Math.exp(frames.mel[t * frames.melBands + m]);\n    }\n    raw[t] = 10 * Math.log10(Math.max(sum, 1e-10));\n  }\n}\n\n/** Centred moving mean, 40 ms wide; truncate at recording boundaries. */\nexport function smoothSonority(raw, output, first, count, hop) {\n  const width = Math.max(1, Math.round(0.04 / hop));\n  const left = Math.floor(width / 2);\n  const right = width - left - 1;\n  for (let t = first; t < count; t++) {\n    let sum = 0;\n    const lo = Math.max(0, t - left);\n    const hi = Math.min(count - 1, t + right);\n    for (let j = lo; j <= hi; j++) {\n      sum += raw[j];\n    }\n    output[t] = sum / (hi - lo + 1);\n  }\n}\n\nfunction rise(frames, t, band, d) {\n  return (\n    frames.band[Math.min(frames.count - 1, t + d) * 6 + band] -\n    frames.band[Math.max(0, t - d) * 6 + band]\n  );\n}\n\nfunction nearestFinePeak(frames, t, b, sign, fine, radius) {\n  let nearest = -1;\n  for (\n    let j = Math.max(1, t - radius);\n    j <= Math.min(frames.count - 2, t + radius);\n    j++\n  ) {\n    const v = sign * rise(frames, j, b, fine);\n    if (\n      v > 0 &&\n      v > sign * rise(frames, j - 1, b, fine) &&\n      v >= sign * rise(frames, j + 1, b, fine) &&\n      (nearest < 0 || Math.abs(j - t) < Math.abs(nearest - t))\n    ) {\n      nearest = j;\n    }\n  }\n  return nearest;\n}\n\nfunction bandPeaks(frames, threshold, first, last, { coarse, fine, radius }) {\n  const peaks = [];\n  for (let b = 0; b < 6; b++) {\n    for (\n      let t = Math.max(1, first - radius);\n      t < Math.min(last + radius, frames.count - 1);\n      t++\n    ) {\n      const value = rise(frames, t, b, coarse);\n      const sign = value > 0 ? 1 : -1;\n      const strength = Math.abs(value);\n      if (\n        strength < threshold ||\n        strength <= Math.abs(rise(frames, t - 1, b, coarse)) ||\n        strength < Math.abs(rise(frames, t + 1, b, coarse))\n      ) {\n        continue;\n      }\n      const nearest = nearestFinePeak(frames, t, b, sign, fine, radius);\n      if (nearest >= first && nearest < last) {\n        peaks.push({ t: nearest, b, sign, strength });\n      }\n    }\n  }\n  return peaks;\n}\n\nfunction participatingBands(frames, peaks, { t, sign }, maxBand) {\n  const bands = new Map();\n  for (const other of peaks) {\n    if (\n      other.b >= 1 &&\n      other.b <= maxBand &&\n      other.sign === sign &&\n      Math.abs(other.t - t) <= Math.round(0.01 / frames.hop)\n    ) {\n      bands.set(other.b, Math.max(bands.get(other.b) ?? 0, other.strength));\n    }\n  }\n  return bands;\n}\n\nfunction addGroupCandidate(frames, peaks, peak, candidates) {\n  const { t, b, sign } = peak;\n  if (b === 0) {\n    return;\n  }\n  const voiced = frames.periodicity[t] >= 0.45;\n  const maxBand = voiced ? 4 : 5;\n  if (b > maxBand) {\n    return;\n  }\n  const bands = participatingBands(frames, peaks, peak, maxBand);\n  if (bands.size >= 3) {\n    candidates.push({\n      t,\n      type: `${voiced ? 's' : 'b'}${sign > 0 ? '+' : '-'}`,\n      strength: [...bands.values()].reduce((a, b) => a + b, 0) / bands.size,\n    });\n  }\n}\n\n/** Coarse peaks are relocated onto the nearest fine peak within 20 ms.\n * Endpoints of a plateau choose its first frame, deterministically. */\nexport function landmarkCandidates(\n  frames,\n  threshold,\n  first = 0,\n  last = frames.count,\n  previous = []\n) {\n  const coarse = Math.max(1, Math.round(0.025 / frames.hop));\n  const fine = Math.max(1, Math.round(0.013 / frames.hop));\n  const radius = Math.round(0.02 / frames.hop);\n  // A candidate near the left edge still needs the bands just before it.\n  const peaks = bandPeaks(\n    frames,\n    threshold,\n    Math.max(0, first - Math.round(0.01 / frames.hop)),\n    last,\n    {\n      coarse,\n      fine,\n      radius,\n    }\n  );\n  const candidates = [];\n  for (const peak of peaks) {\n    const { t, b, sign } = peak;\n    if (t < first) {\n      continue;\n    }\n    const before = frames.periodicity[Math.max(0, t - coarse)] >= 0.45;\n    const after =\n      frames.periodicity[Math.min(frames.count - 1, t + coarse)] >= 0.45;\n    if (b === 0 && before !== after && sign > 0 === after) {\n      candidates.push({\n        t,\n        type: sign > 0 ? 'g+' : 'g-',\n        strength: peak.strength,\n      });\n    }\n    addGroupCandidate(frames, peaks, peak, candidates);\n  }\n  candidates.sort(\n    (a, b) =>\n      a.t - b.t || a.type.localeCompare(b.type) || b.strength - a.strength\n  );\n  // Seed suppression with the last confirmed candidate of each type before\n  // this window. Dropping that history can resurrect a suppressed neighbour.\n  const kept = previous.slice();\n  for (const item of candidates) {\n    const prior = kept.findLastIndex((p) => p.type === item.type);\n    if (prior >= 0 && (item.t - kept[prior].t) * frames.hop < 0.02 - 1e-9) {\n      if (item.strength > kept[prior].strength) {\n        kept[prior] = item;\n      }\n    } else {\n      kept.push(item);\n    }\n  }\n  return kept.sort((a, b) => a.t - b.t || a.type.localeCompare(b.type));\n}\n\n/** The exact ordered decision tree of issue 62, before temporal clean-up. */\nexport function classifyFrame(frames, sonority, t, peak, burst, T) {\n  const e = frames.energy[t] - frames.noise[t];\n  if (!frames.speech[t] && e < T.silence) {\n    return 0;\n  }\n  if (frames.periodicity[t] < T.voiced) {\n    return burst ? 7 : 5;\n  }\n  if (\n    frames.zcr[t] > T.fricativeZcr ||\n    frames.gravity[t] > T.fricativeGravity\n  ) {\n    return 4;\n  }\n  if (\n    frames.band[t * 6] - frames.band[t * 6 + 2] > T.nasalDrop &&\n    sonority[t] < peak - T.nasalBelowPeak\n  ) {\n    return 3;\n  }\n  if (sonority[t] < peak - T.glideBelowPeak) {\n    return 2;\n  }\n  return 1;\n}\n\n/** Median of five class numbers, then bounded silence/run clean-up.\n * Returns a separate array so all run decisions see the same neighbours. */\nfunction medianAndClosures(raw, count, hop) {\n  const median = new Uint8Array(count);\n  const window = new Uint8Array(5);\n  for (let t = 0; t < count; t++) {\n    for (let k = -2; k <= 2; k++) {\n      window[k + 2] = raw[Math.max(0, Math.min(count - 1, t + k))];\n    }\n    window.sort();\n    median[t] = window[2];\n  }\n  const closed = median.slice();\n  for (let start = 0; start < count; ) {\n    let end = start + 1;\n    while (end < count && median[end] === median[start]) {\n      end++;\n    }\n    if (\n      median[start] === 0 &&\n      start > 0 &&\n      end < count &&\n      (end - start) * hop < 0.15 - 1e-9\n    ) {\n      closed.fill(6, start, end);\n    }\n    start = end;\n  }\n  return closed;\n}\n\nexport function cleanClasses(raw, count, hop) {\n  const closed = medianAndClosures(raw, count, hop);\n  const output = closed.slice();\n  for (let start = 0; start < count; ) {\n    let end = start + 1;\n    while (end < count && closed[end] === closed[start]) {\n      end++;\n    }\n    const minimum = closed[start] === 7 ? 0.005 : 0.015;\n    if ((end - start) * hop < minimum - 1e-9) {\n      let left = start;\n      while (left > 0 && closed[left - 1] === closed[start - 1]) {\n        left--;\n      }\n      let right = end;\n      while (right < count && closed[right] === closed[end]) {\n        right++;\n      }\n      if (start > 0 || end < count) {\n        output.fill(\n          start > 0 && (end === count || start - left >= right - end)\n            ? closed[start - 1]\n            : closed[end],\n          start,\n          end\n        );\n      }\n    }\n    start = end;\n  }\n  return output;\n}\n#!/usr/bin/env node\n/** Deterministic coordinate search of the fixed landmark decision tree.\n * Run by hand; no random search and no network. */\nimport { writeFileSync } from 'node:fs';\nimport { fileURLToPath } from 'node:url';\nimport path from 'node:path';\nimport { calibrationMaterial } from './landmark-material.mjs';\nimport {\n  BROAD_CLASSES,\n  landmarkCandidates,\n  classifyFrame,\n  cleanClasses,\n} from '../src/recognition/landmark-signals.js';\n\n/** Inclusive allowed ranges. One search step = (max-min)/20. */\nexport const SEARCH_RANGES = Object.freeze({\n  silence: [0, 20],\n  voiced: [0.25, 0.75],\n  fricativeZcr: [0.05, 0.55],\n  fricativeGravity: [500, 3500],\n  nasalDrop: [0, 40],\n  nasalBelowPeak: [0, 12],\n  glideBelowPeak: [0, 20],\n  nucleusAboveNoise: [0, 20],\n  nucleusDip: [0, 4],\n  landmarkRise: [3, 23],\n});\nexport const INITIAL_THRESHOLDS = Object.freeze({\n  silence: 4,\n  voiced: 0.45,\n  fricativeZcr: 0.2,\n  fricativeGravity: 1800,\n  nasalDrop: 22,\n  nasalBelowPeak: 3,\n  glideBelowPeak: 6,\n  nucleusAboveNoise: 10,\n  nucleusDip: 2,\n  landmarkRise: 9,\n});\n\nfunction bursts(item, rise) {\n  item.burstCache ??= new Map();\n  if (!item.burstCache.has(rise)) {\n    const { frames } = item;\n    const mask = new Uint8Array(frames.count);\n    const candidates = landmarkCandidates(frames, rise);\n    for (const lm of candidates) {\n      if (lm.type === 'b+') {\n        for (\n          let t = lm.t;\n          t < Math.min(frames.count, lm.t + Math.round(0.02 / frames.hop) + 1);\n          t++\n        ) {\n          mask[t] = 1;\n        }\n      }\n    }\n    item.burstCache.set(rise, mask);\n  }\n  return item.burstCache.get(rise);\n}\n\nexport function scoreThresholds(material, T) {\n  const found = new Float64Array(8),\n    total = new Float64Array(8);\n  const rates = {};\n  for (const item of material) {\n    const { frames, sonority, peak, truth } = item;\n    const mask = bursts(item, T.landmarkRise);\n    const raw = new Uint8Array(frames.count);\n    for (let t = 0; t < frames.count; t++) {\n      const earlier = Math.max(0, t - Math.round(0.02 / frames.hop));\n      raw[t] = classifyFrame(\n        frames,\n        sonority,\n        t,\n        peak[t],\n        mask[t] && (raw[earlier] === 0 || raw[earlier] === 6),\n        T\n      );\n    }\n    const classes = cleanClasses(raw, frames.count, frames.hop);\n    rates[frames.rate] ??= {\n      found: new Float64Array(8),\n      total: new Float64Array(8),\n    };\n    for (let t = 0; t < truth.length; t++) {\n      if (truth[t] >= 0) {\n        const k = truth[t];\n        total[k]++;\n        rates[frames.rate].total[k]++;\n        if (classes[t] === k) {\n          found[k]++;\n          rates[frames.rate].found[k]++;\n        }\n      }\n    }\n  }\n  const recalls = Array.from(total, (n, k) => (n ? found[k] / n : null));\n  const present = recalls.filter((x) => x !== null);\n  const perRate = Object.fromEntries(\n    Object.entries(rates).map(([rate, v]) => [\n      rate,\n      Array.from(v.total, (n, k) => (n ? v.found[k] / n : null)),\n    ])\n  );\n  return {\n    mean: present.reduce((a, b) => a + b, 0) / present.length,\n    recalls,\n    perRate,\n    frames: total.reduce((a, b) => a + b, 0),\n  };\n}\n\nexport function calibrate(material) {\n  const T = { ...INITIAL_THRESHOLDS };\n  let best = scoreThresholds(material, T).mean;\n  for (let round = 0; round < 3; round++) {\n    for (const [key, [low, high]] of Object.entries(SEARCH_RANGES)) {\n      const previous = T[key];\n      let chosen = previous;\n      for (let step = 0; step <= 20; step++) {\n        T[key] = Number((low + ((high - low) * step) / 20).toFixed(8));\n        const score = scoreThresholds(material, T).mean;\n        if (score > best + 1e-12) {\n          best = score;\n          chosen = T[key];\n        }\n      }\n      T[key] = chosen;\n    }\n  }\n  return { thresholds: T, ...scoreThresholds(material, T) };\n}\n\nexport function thresholdSource(result) {\n  const percent = (values) =>\n    values.map((v) => (v === null ? 'n/a' : (v * 100).toFixed(3))).join(', ');\n  const properties = Object.entries(result.thresholds)\n    .map(([key, value]) => `  ${key}: ${value},`)\n    .join('\\n');\n  return `/** Generated by node scripts/calibrate-landmarks.mjs.\\n * Class order: ${BROAD_CLASSES.join(', ')}.\\n * Recall (%): ${percent(result.recalls)}.\\n${Object.entries(\n    result.perRate\n  )\n    .map(([rate, values]) => ` * ${rate} Hz recall (%): ${percent(values)}.\\n`)\n    .join(\n      ''\n    )} * ${result.frames} labelled frames; three rounds, 21 values per coordinate.\\n */\\nexport const LANDMARK_THRESHOLDS = Object.freeze({\\n${properties}\\n});\\n`;\n}\n\nif (\n  process.argv[1] &&\n  path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)\n) {\n  const fractionAt = process.argv.indexOf('--fraction');\n  const outAt = process.argv.indexOf('--out');\n  const fraction = fractionAt < 0 ? 1 : Number(process.argv[fractionAt + 1]);\n  const out =\n    outAt < 0\n      ? 'src/recognition/landmark-thresholds.js'\n      : process.argv[outAt + 1];\n  const material = calibrationMaterial(fraction);\n  console.log(`calibration: ${material.length} renders`);\n  const result = calibrate(material);\n  writeFileSync(out, thresholdSource(result));\n  console.log(JSON.stringify(result, null, 2));\n}\n","exit_code":0,"status":"completed"}}
