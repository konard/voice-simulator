[2026-11-17T12:12:49.447Z] [STDOUT] {"type":"item.completed","item":{"id":"item_150","type":"command_execution","command":"/bin/bash -lc 'cat experiments/issue-62/accuracy-ceiling.mjs experiments/issue-62/class-search.mjs experiments/issue-62/edge-feasibility.mjs experiments/issue-62/stream-closure.mjs'","aggregated_output":"/** A necessary condition for silence/closure under the prescribed tree:\n * at least one nearby raw frame must have speech=0. Median-of-five and\n * deletion of runs shorter than 15 ms can only extend a zero by four hops.\n * This generous bound allows every other frame to be correct. */\nimport {\n  synthesize,\n  presetHeadConfig,\n  analyzeFrames,\n} from '../../src/index.js';\nimport { frameTruth } from '../../scripts/landmark-material.mjs';\nconst sentences = [\n  ['en', 'The north wind and the sun were disputing which was the stronger.'],\n  ['ru', 'Мама мыла раму.'],\n  ['hi', 'नमस्ते दुनिया'],\n  ['zh', '你好世界'],\n];\nfor (const rate of [16000, 8000]) {\n  let total = 0,\n    impossible = 0,\n    silence = 0,\n    closure = 0;\n  for (const [lang, text] of sentences) {\n    for (const preset of ['male', 'female']) {\n      const row = countImpossible(lang, text, preset, rate);\n      total += row.total;\n      impossible += row.impossible;\n      silence += row.silence;\n      closure += row.closure;\n    }\n  }\n  console.log(\n    JSON.stringify({\n      rate,\n      total,\n      impossible,\n      silence,\n      closure,\n      ceiling: 1 - impossible / total,\n    })\n  );\n}\n\nfunction countImpossible(lang, text, preset, rate) {\n  let total = 0,\n    impossible = 0,\n    silence = 0,\n    closure = 0;\n  const out = synthesize(text, {\n    lang,\n    head: presetHeadConfig(preset),\n    solver: 'waveguide',\n    engine: 'js',\n    sampleRate: rate,\n    seed: 1,\n  });\n  const frames = analyzeFrames(out.samples, rate),\n    truth = frameTruth(out.plan, frames);\n  for (let t = 0; t < frames.count; t++) {\n    if (truth[t] >= 0) {\n      total++;\n      if (truth[t] !== 0 && truth[t] !== 6) {\n        continue;\n      }\n      let possible = false;\n      for (\n        let j = Math.max(0, t - 4);\n        j <= Math.min(frames.count - 1, t + 4);\n        j++\n      ) {\n        if (!frames.speech[j]) {\n          possible = true;\n        }\n      }\n      if (!possible) {\n        impossible++;\n        if (truth[t] === 0) {\n          silence++;\n        } else {\n          closure++;\n        }\n      }\n    }\n  }\n  return { total, impossible, silence, closure };\n}\n/** Diagnostic only: optimize sentence accuracy with the prescribed tree.\n * This is not calibration: held-out test labels must not set shipped values.\n * Finite search: 3 rounds x 7 coordinates x 21 choices, 16 short renders. */\nimport {\n  synthesize,\n  presetHeadConfig,\n  analyzeFrames,\n} from '../../src/index.js';\nimport {\n  frameTruth,\n  sonorityOf,\n  peakCurve,\n} from '../../scripts/landmark-material.mjs';\nimport {\n  classifyFrame,\n  cleanClasses,\n  landmarkCandidates,\n} from '../../src/recognition/landmark-signals.js';\nimport {\n  INITIAL_THRESHOLDS,\n  SEARCH_RANGES,\n} from '../../scripts/calibrate-landmarks.mjs';\n\nconst material = [];\nfor (const [lang, text] of [\n  ['en', 'The north wind and the sun were disputing which was the stronger.'],\n  ['ru', 'Мама мыла раму.'],\n  ['hi', 'नमस्ते दुनिया'],\n  ['zh', '你好世界'],\n]) {\n  for (const preset of ['male', 'female']) {\n    for (const rate of [16000, 8000]) {\n      const out = synthesize(text, {\n        lang,\n        head: presetHeadConfig(preset),\n        solver: 'waveguide',\n        engine: 'js',\n        sampleRate: rate,\n        seed: 1,\n      });\n      const frames = analyzeFrames(out.samples, rate);\n      const sonority = sonorityOf(frames);\n      material.push({\n        frames,\n        sonority,\n        peak: peakCurve(sonority, frames.hop),\n        truth: frameTruth(out.plan, frames),\n        bursts: landmarkCandidates(frames, 9).filter((l) => l.type === 'b+'),\n      });\n    }\n  }\n}\nfunction score(T, verbose = false) {\n  let found = 0,\n    total = 0;\n  for (const rate of [16000, 8000]) {\n    let correct = 0,\n      labelled = 0;\n    for (const { frames: f, sonority: s, peak, truth, bursts } of material) {\n      if (f.rate !== rate) {\n        continue;\n      }\n      const raw = new Uint8Array(f.count);\n      for (let t = 0; t < f.count; t++) {\n        const earlier = Math.max(0, t - Math.round(0.02 / f.hop));\n        const burst =\n          (raw[earlier] === 0 || raw[earlier] === 6) &&\n          bursts.some((l) => l.t <= t && (t - l.t) * f.hop <= 0.02 + 1e-9);\n        raw[t] = classifyFrame(f, s, t, peak[t], burst, T);\n      }\n      const classes = cleanClasses(raw, f.count, f.hop);\n      for (let t = 0; t < f.count; t++) {\n        if (truth[t] < 0) {\n          continue;\n        }\n        labelled++;\n        if (truth[t] === classes[t]) {\n          correct++;\n        }\n      }\n    }\n    if (verbose) {\n      console.log(\n        JSON.stringify({\n          rate,\n          correct,\n          labelled,\n          accuracy: correct / labelled,\n        })\n      );\n    }\n    found += correct;\n    total += labelled;\n  }\n  return found / total;\n}\nconst T = { ...INITIAL_THRESHOLDS };\nlet best = score(T);\nconsole.log('initial', best);\nfor (let round = 0; round < 3; round++) {\n  for (const [key, [low, high]] of Object.entries(SEARCH_RANGES).slice(0, 7)) {\n    let chosen = T[key];\n    for (let step = 0; step <= 20; step++) {\n      T[key] = low + ((high - low) * step) / 20;\n      const accuracy = score(T);\n      if (accuracy > best) {\n        best = accuracy;\n        chosen = T[key];\n      }\n    }\n    T[key] = chosen;\n  }\n  console.log(JSON.stringify({ round, best, thresholds: T }));\n}\nscore(T, true);\n/** Necessary condition for the requested apa g- edge, independent of the\n * detector and its thresholds: its time must be a falling fine-band peak.\n * Bound the input to one seeded render and inspect every such peak, even\n * without coarse peaks, voicing, strength or suppression requirements.\n * Run: node --max-old-space-size=128 experiments/issue-62/edge-feasibility.mjs\n */\nimport assert from 'node:assert/strict';\nimport {\n  synthesize,\n  presetHeadConfig,\n  analyzeFrames,\n} from '../../src/index.js';\n\nconst rate = 16000;\nconst out = synthesize('apa', {\n  ipa: true,\n  head: presetHeadConfig('male'),\n  solver: 'waveguide',\n  engine: 'js',\n  sampleRate: rate,\n  seed: 1,\n});\nconst frames = analyzeFrames(out.samples, rate);\nconst target = out.plan.segments.find((s) => s.kind === 'consonant').start;\nconst tolerance = 0.02;\n\n// Linear interpolation also checks the literal 13 ms difference rather\n// than relying solely on the implementation's nearest-frame rounding.\nfunction band(index) {\n  const at = Math.max(0, Math.min(frames.count - 1, index));\n  const left = Math.floor(at);\n  const weight = at - left;\n  return (\n    frames.band[left * 6] * (1 - weight) +\n    frames.band[Math.min(left + 1, frames.count - 1) * 6] * weight\n  );\n}\n\nfunction inspect(label, distance, continuous = false) {\n  const points = [0, frames.count - 1];\n  if (continuous) {\n    // Include the acceptance interval and its centre so a flat positive\n    // plateau intersecting it is allowed even when its ends lie outside.\n    points.push(\n      (target - tolerance) / frames.hop,\n      target / frames.hop,\n      (target + tolerance) / frames.hop\n    );\n  }\n  for (let t = 0; t < frames.count; t++) {\n    if (continuous) {\n      // All slope changes of band(t+d)-band(t-d). Between these points\n      // the difference is linear, so no strict peak can be omitted.\n      for (const at of [t - distance, t + distance]) {\n        if (at >= 0 && at < frames.count - 1) {\n          points.push(at);\n        }\n      }\n    } else {\n      points.push(t);\n    }\n  }\n  const grid = [...new Set(points)].sort((a, b) => a - b);\n  const falls = grid.map((t) => band(t - distance) - band(t + distance));\n  const peaks = grid\n    .filter(\n      (_, i) =>\n        i > 0 &&\n        i + 1 < grid.length &&\n        falls[i] > 0 &&\n        falls[i] >= falls[i - 1] &&\n        falls[i] >= falls[i + 1]\n    )\n    .map((t) => ({\n      time: t * frames.hop,\n      error: Math.abs(t * frames.hop - target),\n    }));\n  const reachable = peaks.filter((p) => p.error <= tolerance + 1e-9);\n  const nearest = peaks.sort((a, b) => a.error - b.error)[0];\n  assert(nearest, 'the render must have a falling band-0 peak');\n  assert.deepEqual(reachable, [], `${label}: unexpectedly feasible edge`);\n  console.log(\n    JSON.stringify({\n      label,\n      target,\n      tolerance,\n      nearest,\n      reachable: reachable.length,\n    })\n  );\n}\n\ninspect('fine rounded to 15 ms', Math.round(0.013 / frames.hop));\ninspect('fine rounded down to 10 ms', Math.floor(0.013 / frames.hop));\ninspect('fine interpolated at 13 ms, frame grid', 0.013 / frames.hop);\ninspect(\n  'fine interpolated at 13 ms, continuous time',\n  0.013 / frames.hop,\n  true\n);\n/** Public-API counterexample to simultaneous 60 ms immutable commitment\n * and retrospective closure cleanup. Finite input: two one-second signals.\n * Run: node --max-old-space-size=64 experiments/issue-62/stream-closure.mjs\n * Passing assertions prove the incompatibility, not detector acceptance. */\nimport assert from 'node:assert/strict';\nimport {\n  analyzeFrames,\n  createFrameAnalyzer,\n  createLandmarkDetector,\n  findLandmarks,\n} from '../../src/index.js';\n\nconst rate = 8000;\nconst hop = 0.005;\nconst frameTime = 0.36;\nconst commitmentDeadline = frameTime + 0.06;\n// Supply the front end's 12.5 ms window lookahead, too. The two signals\n// still agree through this later point, before either return to speech.\nconst suppliedThrough = commitmentDeadline + 0.0125;\nconst prefixSamples = Math.round(suppliedThrough * rate);\nconst target = Math.round(frameTime / hop);\nconst speechReturns = [0.44, 0.6];\nconst signals = speechReturns.map((resume) => {\n  const samples = new Float32Array(rate);\n  for (let n = 0; n < samples.length; n++) {\n    const time = n / rate;\n    if (\n      (time >= 0.1 && time < 0.3) ||\n      (time >= resume && time < resume + 0.2)\n    ) {\n      samples[n] = 0.1 * Math.sin((2 * Math.PI * 140 * n) / rate);\n    }\n  }\n  return samples;\n});\nassert.deepEqual(\n  signals[0].subarray(0, prefixSamples),\n  signals[1].subarray(0, prefixSamples)\n);\nconst required = signals.map((samples) =>\n  findLandmarks(analyzeFrames(samples, rate)).classes.at(target)\n);\nassert.deepEqual(required, [6, 0]);\nconst streams = signals.map((samples) => {\n  const analyzer = createFrameAnalyzer(rate, { maxSeconds: 1 });\n  const detector = createLandmarkDetector(analyzer.frames);\n  analyzer.push(samples.subarray(0, prefixSamples));\n  detector.advance();\n  assert(detector.output.committed > target);\n  return { analyzer, detector, samples };\n});\nfor (const [key, width] of [\n  ['energy', 1],\n  ['noise', 1],\n  ['periodicity', 1],\n  ['speech', 1],\n  ['zcr', 1],\n  ['gravity', 1],\n  ['tilt', 1],\n  ['band', 6],\n  ['mel', streams[0].analyzer.frames.melBands],\n]) {\n  const a = streams[0].analyzer.frames;\n  const b = streams[1].analyzer.frames;\n  assert.equal(a.count, b.count);\n  assert.deepEqual(\n    a[key].subarray(0, a.count * width),\n    b[key].subarray(0, b.count * width)\n  );\n}\nconst atDeadline = streams.map((s) => s.detector.output.classes.at(target));\nassert.equal(atDeadline[0], atDeadline[1]);\nfor (const { analyzer, detector, samples } of streams) {\n  analyzer.push(samples.subarray(prefixSamples));\n  analyzer.flush();\n  detector.advance(true);\n}\nconst final = streams.map((s) => s.detector.output.classes.at(target));\nassert.deepEqual(final, atDeadline);\nassert.notDeepEqual(final, required);\nconsole.log(\n  JSON.stringify({\n    frameTime,\n    commitmentDeadline,\n    suppliedThrough,\n    speechReturns,\n    requiredBatchClasses: required,\n    committedStreamClasses: atDeadline,\n    finalStreamClasses: final,\n  })\n);\n","exit_code":0,"status":"completed"}}
