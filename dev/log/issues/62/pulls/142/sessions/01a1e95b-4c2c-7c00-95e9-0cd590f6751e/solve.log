[2026-11-17T12:08:43.007Z] [STDOUT] {"type":"item.completed","item":{"id":"item_115","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' crates/voice-simulator-wasm/src/landmarks.rs && git diff origin/main -- tests/cli-audio.test.js tests/engine-size.test.js .github/workflows/release.yml docs/RUST-ENGINE.md docs/case-studies/README.md crates/voice-simulator-core/src/lib.rs && cat /sys/fs/cgroup/memory.current && ps -eo pid,rss,etime,args --sort=-rss | head -n 7\"","aggregated_output":"//! Batch landmark parity entry point. Packed layout is documented in the\n//! core module and tests/rust-landmarks.test.js. Input is copied before\n//! borrowing output, so the two ranges may overlap safely.\nuse crate::{error, f64_slice};\nuse voice_simulator_core::landmarks::{find_landmarks, Frames, Thresholds};\n\n/// Input: count rows of 13+mel_bands doubles; thresholds: ten doubles.\n/// Output: twelve doubles per frame: class, sonority, nucleus flag, start,\n/// end (-1 if unknown), strength, then strengths for b+,b-,g+,g-,s+,s-.\n#[no_mangle]\npub extern \"C\" fn vs_landmarks(\n    input: u32,\n    count: u32,\n    mel_bands: u32,\n    rate: f64,\n    hop: f64,\n    thresholds: u32,\n    output: u32,\n) -> i32 {\n    if count > 1_000_000\n        || !(1..=1024).contains(&mel_bands)\n        || !rate.is_finite()\n        || rate < 8000.0\n        || (hop != 0.005 && hop != 0.01)\n    {\n        return error::BAD_ARGUMENT;\n    }\n    let Some(input_count) = count.checked_mul(13 + mel_bands) else {\n        return error::BAD_ARGUMENT;\n    };\n    let rows = match f64_slice(input, input_count) {\n        Ok(v) => v.to_vec(),\n        Err(code) => return code,\n    };\n    let mut values = [0.0; 10];\n    match f64_slice(thresholds, 10) {\n        Ok(v) => values.copy_from_slice(v),\n        Err(code) => return code,\n    }\n    if rows.iter().chain(values.iter()).any(|v| !v.is_finite())\n        || values[1] < 0.0\n        || values[1] > 1.0\n        || values[8] < 0.0\n        || values[9] <= 0.0\n    {\n        return error::BAD_ARGUMENT;\n    }\n    let result = find_landmarks(\n        &Frames {\n            rows: &rows,\n            count: count as usize,\n            mel_bands: mel_bands as usize,\n            rate,\n            hop,\n        },\n        &Thresholds(values),\n    );\n    let out = match f64_slice(output, count * 12) {\n        Ok(v) => v,\n        Err(code) => return code,\n    };\n    out.fill(0.0);\n    for t in 0..count as usize {\n        out[t * 12] = result.classes[t] as f64;\n        out[t * 12 + 1] = result.sonority[t] as f64;\n    }\n    for nucleus in result.nuclei {\n        let row = nucleus.frame * 12;\n        out[row + 2] = 1.0;\n        out[row + 3] = nucleus.start as f64;\n        out[row + 4] = nucleus.end.map_or(-1.0, |t| t as f64);\n        out[row + 5] = nucleus.strength;\n    }\n    for landmark in result.landmarks {\n        out[landmark.frame * 12 + 6 + landmark.kind] = landmark.strength;\n    }\n    error::OK\n}\ndiff --git a/.github/workflows/release.yml b/.github/workflows/release.yml\nindex e45c2ff..1071d21 100644\n--- a/.github/workflows/release.yml\n+++ b/.github/workflows/release.yml\n@@ -546,7 +546,7 @@ jobs:\n         # developer machine, issue 23), hence the larger budget.\n         # tests/performance-smoke.test.js (issue 31) runs in npm test too,\n         # but only here with the engine: Rust is not slower than JavaScript.\n-        run: bash scripts/run-with-budget-warning.sh 90 \"Rust parity tests\" node --test tests/engine-parity.test.js tests/engine-features.test.js tests/rust-parity.test.js tests/rust-recognition.test.js tests/rust-inverse-filter.test.js tests/rust-waveguide.test.js tests/rust-fdtd.test.js tests/rust-render-job.test.js tests/engine-layout.test.js tests/engine.test.js tests/engine-worker.test.js tests/engine-size.test.js tests/adaptive-stream.test.js tests/stream-governor.test.js tests/performance-smoke.test.js\n+        run: bash scripts/run-