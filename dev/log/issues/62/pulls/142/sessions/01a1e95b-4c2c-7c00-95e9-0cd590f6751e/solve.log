[2026-11-17T12:07:06.747Z] [STDOUT] {"type":"item.completed","item":{"id":"item_96","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' scripts/landmark-material.mjs && cat tests/heavy/helpers/report.js && sed -n '1,100p' .gitignore\"","aggregated_output":"/** Shared labelled material for calibration and independent accuracy tests.\n * Segment edges are excluded by 10 ms, as specified in issue 62. */\nimport { synthesize, presetHeadConfig, analyzeFrames } from '../src/index.js';\nimport { CONSONANTS } from '../src/ipa/inventory.js';\nimport { createRandom } from '../src/random.js';\nimport {\n  sonorityFilters,\n  fillSonority,\n  smoothSonority,\n} from '../src/recognition/landmark-signals.js';\n\nexport function segmentClass(segment, previous) {\n  if (segment.kind === 'pause') {\n    return 0;\n  }\n  if (segment.kind === 'vowel') {\n    return 1;\n  }\n  if (segment.kind === 'release') {\n    return 7;\n  }\n  return consonantClass(segment, previous);\n}\n\nfunction consonantClass(segment, previous) {\n  // The planner represents an affricate as two consonant segments sharing\n  // one token: [REDACTED] stop closure, then its voiced or unvoiced frication.\n  if (segment.token?.affricate) {\n    return previous?.token =[REDACTED] segment.token\n      ? segment.token.voiced\n        ? 4\n        : 5\n      : 6;\n  }\n  const manner = segment.token?.phoneme?.manner;\n  if (manner === 'plosive' || manner === 'click') {\n    return 6;\n  }\n  if (manner === 'nasal') {\n    return 3;\n  }\n  if (manner === 'fricative' || manner === 'lateral-fricative') {\n    return segment.token.voiced ? 4 : 5;\n  }\n  return 2;\n}\n\nexport function frameTruth(plan, frames) {\n  const truth = new Int8Array(frames.count).fill(-1);\n  for (let t = 0, i = 0; t < frames.count; t++) {\n    const time = frames.startTime + t * frames.hop;\n    while (i + 1 < plan.segments.length && plan.segments[i].end <= time) {\n      i++;\n    }\n    const seg = plan.segments[i];\n    if (time >= seg.start + 0.01 && time <= seg.end - 0.01) {\n      truth[t] = segmentClass(seg, plan.segments[i - 1]);\n    }\n  }\n  return truth;\n}\n\nexport function sonorityOf(frames) {\n  const raw = new Float32Array(frames.count);\n  const s = new Float32Array(frames.count);\n  fillSonority(frames, raw, 0, sonorityFilters(frames));\n  smoothSonority(raw, s, 0, frames.count, frames.hop);\n  return s;\n}\n\nexport function peakCurve(s, hop) {\n  const peak = new Float32Array(s.length);\n  for (let t = 0; t < s.length; t++) {\n    let max = -Infinity;\n    for (\n      let j = Math.max(0, t - Math.round(0.2 / hop));\n      j <= Math.min(s.length - 1, t + Math.round(0.04 / hop));\n      j++\n    ) {\n      max = Math.max(max, s[j]);\n    }\n    peak[t] = max;\n  }\n  return peak;\n}\n\n/** Deterministic striding samples vowels, rates and voices evenly,\n * retaining both the clean and noisy rendition of each selected item. */\nexport function calibrationMaterial(fraction = 1) {\n  if (!(fraction > 0 && fraction <= 1)) {\n    throw new RangeError('fraction must be in (0,1]');\n  }\n  const stride = Math.round(1 / fraction);\n  const material = [];\n  let index = 0;\n  for (const phone of Object.keys(CONSONANTS)) {\n    for (const vowel of ['a', 'i', 'u']) {\n      for (const preset of ['male', 'female', 'child']) {\n        for (const rate of [8000, 11025, 16000]) {\n          if (index++ % stride !== 0) {\n            continue;\n          }\n          material.push(...renderPair(phone, vowel, preset, rate));\n        }\n      }\n    }\n  }\n  return material;\n}\n\nfunction renderPair(phone, vowel, preset, rate) {\n  const material = [];\n  const out = synthesize(`${vowel}${phone}${vowel}`, {\n    ipa: true,\n    head: presetHeadConfig(preset),\n    solver: 'waveguide',\n    engine: 'js',\n    sampleRate: rate,\n    seed: 1,\n  });\n  let power = 0;\n  for (const sample of out.samples) {\n    power += sample * sample;\n  }\n  const noiseAmplitude = Math.sqrt((3 * power) / out.samples.length / 100);\n  for (let noisy = 0; noisy < 2; noisy++) {\n    const random = createRandom(\n      `landmarks:${phone}:${vowel}:${preset}:${rate}`\n    );\n    const samples = noisy\n      ? Float32Array.from(\n          out.samples,\n          (x) => x + noiseAmplitude * (2 * random() - 1)\n        )\n      : out.samples;\n    const original = analyzeFrames(samples, rate);\n    const frames = {\n      rate,\n      hop: original.hop,\n      count: original.count,\n      capacity: original.count,\n      startTime: 0,\n      melBands: original.melBands,\n    };\n    for (const key of [\n      'energy',\n      'noise',\n      'speech',\n      'periodicity',\n      'zcr',\n      'gravity',\n      'tilt',\n      'band',\n    ]) {\n      frames[key] = original[key].slice(\n        0,\n        original.count * (key === 'band' ? 6 : 1)\n      );\n    }\n    const sonority = sonorityOf(original);\n    material.push({\n      id: `${vowel}${phone}${vowel}:${preset}:${rate}:${noisy}`,\n      frames,\n      sonority,\n      peak: peakCurve(sonority, frames.hop),\n      truth: frameTruth(out.plan, frames),\n    });\n  }\n  return material;\n}\n/**\n * Helpers for the heavy tests in tests/heavy/ (see tests/heavy/README.md).\n * scripts/run-heavy.mjs passes the item limit as HEAVY_LIMIT and the report\n * folder as HEAVY_OUT.\n */\n\nimport { mkdirSync, writeFileSync } from 'node:fs';\nimport path from 'node:path';\n\n/** Report folder used when HEAVY_OUT is not set. */\nexport const DEFAULT_HEAVY_OUT = 'reports/heavy';\n\n/**\n * The largest number of items (utterances, files) a test may process.\n * @param {number} fallback used when HEAVY_LIMIT is not a positive integer\n * @returns {number}\n */\nexport function heavyLimit(fallback) {\n  const limit = Number(process.env.HEAVY_LIMIT);\n  return Number.isInteger(limit) && limit > 0 ? limit : fallback;\n}\n\n/** @returns {string} the folder reports are written to */\nexport function heavyOut() {\n  return process.env.HEAVY_OUT || DEFAULT_HEAVY_OUT;\n}\n\n/**\n * Write <HEAVY_OUT>/<name>.md and <HEAVY_OUT>/<name>.json.\n * @param {string} name report name, also the file name without extension\n * @param {string} markdown Markdown shown in the run summary\n * @param {unknown} data numbers behind the Markdown\n * @returns {{markdown: string, json: string}} paths of the written files\n */\nexport function writeReport(name, markdown, data) {\n  const out = heavyOut();\n  mkdirSync(out, { recursive: true });\n  const markdownPath = path.join(out, `${name}.md`);\n  const jsonPath = path.join(out, `${name}.json`);\n  writeFileSync(\n    markdownPath,\n    markdown.endsWith('\\n') ? markdown : `${markdown}\\n`\n  );\n  writeFileSync(jsonPath, `${JSON.stringify(data, null, 2)}\\n`);\n  return { markdown: markdownPath, json: jsonPath };\n}\n# Logs\nlogs\n*.log\nnpm-debug.log*\nyarn-debug.log*\nyarn-error.log*\nlerna-debug.log*\n\n# Diagnostic reports (https://nodejs.org/api/report.html)\nreport.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json\n\n# Runtime data\npids\n*.pid\n*.seed\n*.pid.lock\n\n# Directory for instrumented libs generated by jscoverage/JSCover\nlib-cov\n\n# Coverage directory used by tools like istanbul\ncoverage\n*.lcov\n\n# nyc test coverage\n.nyc_output\n\n# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)\n.grunt\n\n# Bower dependency directory (https://bower.io/)\nbower_components\n\n# node-waf configuration\n.lock-wscript\n\n# Compiled binary addons (https://nodejs.org/api/addons.html)\nbuild/Release\n\n# Dependency directories\nnode_modules/\njspm_packages/\n\n# Snowpack dependency directory (https://snowpack.dev/)\nweb_modules/\n\n# TypeScript cache\n*.tsbuildinfo\n\n# Optional npm cache directory\n.npm\n\n# Optional eslint cache\n.eslintcache\n.playwright-mcp/\n\n# Optional stylelint cache\n.stylelintcache\n\n# Optional REPL history\n.node_repl_history\n\n# Output of 'npm pack'\n*.tgz\n\n# Yarn Integrity file\n.yarn-integrity\n\n# dotenv environment variable files\n.env\n.env.*\n!.env.example\n\n# parcel-bundler cache (https://parceljs.org/)\n.cache\n.parcel-cache\n\n# Next.js build output\n.next\nout\n\n# Nuxt.js build / generate output\n.nuxt\ndist\n\n# Gatsby files\n.cache/\n# Comment in the public line in if your project uses Gatsby and not Next.js\n# https://nextjs.org/blog/next-9-1#public-directory-support\n# public\n\n# vuepress build output\n.vuepress/dist\n\n# vuepress v2.x temp and cache directory\n.temp\n.cache\n\n# Sveltekit cache directory\n.svelte-kit/\n","exit_code":0,"status":"completed"}}
