#!/usr/bin/env bash
#
# Offline `gh` stub for the scripts/check-dependency-graph.sh tests.
# Logs each call to $DEPENDENCY_GRAPH_FIXTURE_DIR/requests and answers from
# files in the same directory:
#
#   parent         -- SHA printed for `gh api repos/<repo>/commits/<sha>`
#   compare_status -- 200, or the HTTP status the compare call fails with

set -u

FIX="${DEPENDENCY_GRAPH_FIXTURE_DIR:?DEPENDENCY_GRAPH_FIXTURE_DIR must point at the fixture files}"
printf '%s\n' "$*" >>"$FIX/requests"

case "$2" in
  */dependency-graph/compare/*)
    status="$(cat "$FIX/compare_status")"
    if [ "$status" = 200 ]; then
      printf '[]\n'
      exit 0
    fi
    printf 'gh: Stub answer (HTTP %s)\n' "$status" >&2
    exit 1
    ;;
  */commits/*)
    cat "$FIX/parent"
    ;;
  *)
    printf 'unexpected gh call: %s\n' "$*" >&2
    exit 1
    ;;
esac
