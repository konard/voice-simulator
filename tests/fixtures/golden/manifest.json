    {
      "id": "hi-05",
      "lang": "hi",
      "file": "hi-05.flac",
      "text": "कभी कोठे पर जाती थी, कभी नीचे आती थी।",
      "ipa": "kəbʱiː koːʈʰeː pəɾ d͡ʒaːt̪iː t̪ʰiː kəbʱiː niːt͡ʃeː aːt̪iː t̪ʰiː",
      "speaker": {
        "id": "librivox-19651",
        "sex": "unknown"
      },
      "duration": 3.475,
      "sha256": "d8cbb23729e81a3eb3ae290bae704a92ef3e4a79e9671f48202cfd171169b666",
      "source": {
        "dataset": "librivox-do-sakhiyan-hi-06",
