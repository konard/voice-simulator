    },
    {
      "id": "en-02",
      "lang": "en",
      "file": "en-02.flac",
      "text": "But when they cut it open they found it was just like any other goose.",
      "ipa": "bət ˈwɛn ðeɪ ˈkʌt ɪt ˈoʊpən ðeɪ ˈfaʊnd ɪt wəz ˈd͡ʒʌst ˈlaɪk ˈɛni ˈʌðɚ ˈɡus",
      "speaker": {
        "id": "librivox-201",
        "sex": "unknown"
      },
      "duration": 4.035,
      "sha256": "5c77439b80606433807ba4ef88f1a3883de804f2127cb3317801916ba2789e6e",
      "source": {
        "dataset": "librivox-aesop-en-02",
        "page": "https://librivox.org/aesops-fables-volume-1-fables-1-25/",
        "licence": "Public-Domain",
        "start": 33.835,
        "end": 37.87
      },
      "textSource": "V. S. Vernon Jones, Aesop's Fables: a new translation (1912), https://www.gutenberg.org/ebooks/11339",
      "review": {
        "text": "unreviewed",
        "ipa": "unreviewed",
        "by": null
      }
    },
    {
      "id": "en-03",
      "lang": "en",
      "file": "en-03.flac",
      "text": "Look and see which way the wind blows before you commit yourself.",
      "ipa": "ˈlʊk ənd ˈsi ˈwɪt͡ʃ ˈweɪ ðə ˈwɪnd ˈbloʊz bɪˈfɔɹ ju kəˈmɪt jɚˈsɛlf",
      "speaker": {
        "id": "librivox-246",
        "sex": "unknown"
      },
      "duration": 3.645,
      "sha256": "c472c5022dbb2c1cf1f575b8e053ec2252c7e4a3300fcb7386b8f5ad99da499c",
      "source": {
        "dataset": "librivox-aesop-en-07",
        "page": "https://librivox.org/aesops-fables-volume-1-fables-1-25/",
        "licence": "Public-Domain",
        "start": 44.055,
        "end": 47.7
      },
      "textSource": "V. S. Vernon Jones, Aesop's Fables: a new translation (1912), https://www.gutenberg.org/ebooks/11339",
      "review": {
        "text": "unreviewed",
