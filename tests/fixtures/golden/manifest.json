        "by": null
      }
    },
    {
      "id": "en-04",
      "lang": "en",
      "file": "en-04.flac",
      "text": "A Peacock taunted a Crane with the dullness of her plumage.",
      "ipa": "ə ˈpikɑk ˈtɔntɪd ə ˈkɹeɪn wɪð ðə ˈdʌlnəs əv hɚ ˈplumɪd͡ʒ",
      "speaker": {
        "id": "librivox-246",
        "sex": "unknown"
      },
      "duration": 5.13,
      "sha256": "49e2ad6d061a7a777929a29ad75afe3671a83cc0152d4f3ed73d670e2ab6a47b",
      "source": {
        "dataset": "librivox-aesop-en-12",
        "page": "https://librivox.org/aesops-fables-volume-1-fables-1-25/",
        "licence": "Public-Domain",
        "start": 22.515,
        "end": 27.645
      },
      "textSource": "V. S. Vernon Jones, Aesop's Fables: a new translation (1912), https://www.gutenberg.org/ebooks/11339",
      "review": {
        "text": "unreviewed",
        "ipa": "unreviewed",
        "by": null
      }
    },
    {
      "id": "en-05",
      "lang": "en",
      "file": "en-05.flac",
      "text": "Her beauty is without equal, the hue of her plumage exquisite.",
      "ipa": "hɚ ˈbjuɾi ɪz wɪˈθaʊt ˈikwəl ðə ˈhju əv hɚ ˈplumɪd͡ʒ ˈɛkskwɪzɪt",
      "speaker": {
        "id": "librivox-19",
        "sex": "unknown"
      },
      "duration": 5.265,
      "sha256": "0ea961d9c5affa499134b581ce15abc54965c122ef315bcc80f004bebce14d03",
      "source": {
        "dataset": "librivox-aesop-en-09",
        "page": "https://librivox.org/aesops-fables-volume-1-fables-1-25/",
        "licence": "Public-Domain",
        "start": 45.67,
        "end": 50.935
      },
      "textSource": "V. S. Vernon Jones, Aesop's Fables: a new translation (1912), https://www.gutenberg.org/ebooks/11339",
      "review": {
        "text": "unreviewed",
        "ipa": "unreviewed",
        "by": null
      }
    },
    {
      "id": "en-06",
      "lang": "en",
      "file": "en-06.flac",
      "text": "Betray a friend, and you'll often find you have ruined yourself.",
      "ipa": "bɪˈtɹeɪ ə ˈfɹɛnd ənd jul ˈɔfən ˈfaɪnd ju hæv ˈɹuənd jɚˈsɛlf",
      "speaker": {
        "id": "librivox-30",
        "sex": "unknown"
      },
      "duration": 5.795,
      "sha256": "fd58a2b55a04b1bde5c8ba7c3742995186539781344ee639c0d17239cb9b6c69",
      "source": {
        "dataset": "librivox-aesop-en-18",
        "page": "https://librivox.org/aesops-fables-volume-1-fables-1-25/",
        "licence": "Public-Domain",
