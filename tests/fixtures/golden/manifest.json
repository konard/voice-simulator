        "by": null
      }
    },
    {
      "id": "hi-06",
      "lang": "hi",
      "file": "hi-06.flac",
      "text": "इस विषय में तुम्हें मुझसे उपदेश लेना चाहिए।",
      "ipa": "ɪs ʋɪʃəj mẽː t̪ʊmɦẽː mʊd͡ʒʱseː ʊpd̪eːʃ leːnaː t͡ʃaːɦɪeː",
      "speaker": {
        "id": "librivox-19651",
        "sex": "unknown"
      },
      "duration": 3.71,
      "sha256": "4255b346a1a13a23059bd5729e244975904dc342dedd9d3fb533ab9f9e086d36",
      "source": {
        "dataset": "librivox-do-sakhiyan-hi-06",
