    {
      "id": "hi-03",
      "lang": "hi",
      "file": "hi-03.flac",
      "text": "अगर माता-पिता अकाल मर जायँ, तो लड़की का विवाह कौन करे।",
      "ipa": "əɡəɾ maːt̪aːpɪt̪aː əkaːl məɾ d͡ʒaːẽː t̪oː ləɽkiː kaː ʋɪʋaːɦ kɔːn kəɾeː",
      "speaker": {
        "id": "librivox-19651",
        "sex": "unknown"
      },
      "duration": 5.075,
      "sha256": "50b8a976b72166209a372f086ee486fe3fa86636f5dc7deaabbaee890e4d4ab0",
