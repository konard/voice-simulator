    {
      "id": "en-01",
      "lang": "en",
      "file": "en-01.flac",
      "text": "Persuasion is better than force.",
      "ipa": "pɚˈsweɪʒən ɪz ˈbɛɾɚ ðən ˈfɔɹs",
      "speaker": {
        "id": "librivox-215",
