        "by": null
      }
    },
    {
      "id": "ru-06",
      "lang": "ru",
      "file": "ru-06.flac",
      "text": "Вот через неделю я увижу, кто больше и лучше мёду наделает.",
      "ipa": "vot ˈt͡ɕerʲɪs nʲɪˈdʲelʲʊ ja ʊˈvʲiʐʊ kto ˈbolʲʂɨ i ˈɫutʂːɨ ˈmʲodʊ nɐˈdʲeɫəjɪt",
      "speaker": {
        "id": "librivox-3056",
        "sex": "unknown"
      },
      "duration": 4.995,
      "sha256": "195e8a2aff62aa2f8e5351da67cabff7da6a82b06ae086a63d17d58397a5d169",
