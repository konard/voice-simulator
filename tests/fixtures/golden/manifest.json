    {
      "id": "ru-01",
      "lang": "ru",
      "file": "ru-01.flac",
      "text": "Старый больной лев лежал в пещере.",
      "ipa": "ˈstarɨj bɐlʲˈnoj lʲef lʲɪˈʐaɫ f pʲɪˈɕːerʲɪ",
      "speaker": {
        "id": "librivox-1593",
        "sex": "unknown"
      },
      "duration": 3.16,
      "sha256": "98b14ea6819691f0b6f7d5b31bbe58b3a2fde876876df54f295bbb6d5b412e96",
