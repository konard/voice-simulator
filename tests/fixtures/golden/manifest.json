        "by": null
      }
    },
    {
      "id": "ru-05",
      "lang": "ru",
      "file": "ru-05.flac",
      "text": "Я ещё не знаю, кто из вас мёд делает.",
      "ipa": "ja jɪˈɕːo nʲɪ ˈznajʊ kto ɪz vas mʲot ˈdʲeɫəjɪt",
      "speaker": {
        "id": "librivox-3056",
        "sex": "unknown"
      },
      "duration": 3.085,
      "sha256": "a1d75949fc17d06c202cf666d87695d75d44833b37b1f9bce8182b00cf39bb94",
      "source": {
